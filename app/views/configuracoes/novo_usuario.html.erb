<div class="pb-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Criar Novo Usuário</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-1">Adicione um novo membro à equipe</p>
      </div>
      <%= link_to configuracoes_path, class: "px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] transition-colors" do %>
        <i class="fas fa-arrow-left mr-2"></i>Voltar
      <% end %>
    </div>

    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-[#2E2E2E]">
      
      <%= form_with model: @user, url: configuracoes_criar_usuario_path, method: :post, local: true, class: "space-y-6" do |f| %>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :nome, "Nome Completo", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= f.text_field :nome, class: "w-full px-4 py-2 bg-white dark:bg-[#0F0F0F] border border-gray-300 dark:border-[#2E2E2E] rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-[#C5A300] focus:border-transparent transition-all", placeholder: "Nome completo", required: true %>
            <% if @user.errors[:nome].any? %>
              <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:nome].first %></p>
            <% end %>
          </div>

          <div>
            <%= f.label :usuario, "Nome de Usuário", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= f.text_field :usuario, class: "w-full px-4 py-2 bg-white dark:bg-[#0F0F0F] border border-gray-300 dark:border-[#2E2E2E] rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-[#C5A300] focus:border-transparent transition-all", placeholder: "usuario", required: true %>
            <% if @user.errors[:usuario].any? %>
              <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:usuario].first %></p>
            <% end %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= f.email_field :email, class: "w-full px-4 py-2 bg-white dark:bg-[#0F0F0F] border border-gray-300 dark:border-[#2E2E2E] rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-[#C5A300] focus:border-transparent transition-all", placeholder: "email@exemplo.com", required: true %>
            <% if @user.errors[:email].any? %>
              <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:email].first %></p>
            <% end %>
          </div>

          <div>
            <%= f.label :telefone, "Telefone", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= f.text_field :telefone, class: "w-full px-4 py-2 bg-white dark:bg-[#0F0F0F] border border-gray-300 dark:border-[#2E2E2E] rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-[#C5A300] focus:border-transparent transition-all", placeholder: "(00) 00000-0000" %>
            <% if @user.errors[:telefone].any? %>
              <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:telefone].first %></p>
            <% end %>
          </div>
        </div>

        <div>
          <%= f.label :role, "Cargo/Função", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3" %>
          <div class="grid grid-cols-2 gap-3">
            <label class="relative flex items-center p-3 bg-white dark:bg-[#0F0F0F] border-2 border-gray-300 dark:border-[#2E2E2E] rounded-lg cursor-pointer hover:border-[#C5A300] transition-all">
              <%= f.radio_button :role, 'professor', class: "peer sr-only" %>
              <div class="flex items-center gap-3 w-full">
                <div class="w-10 h-10 bg-gradient-to-br from-teal-500 to-teal-600 rounded-lg flex items-center justify-center text-white flex-shrink-0">
                  <i class="fas fa-chalkboard-teacher"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <span class="block text-sm font-bold text-gray-900 dark:text-white">Professor</span>
                  <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Gerencia turmas</span>
                </div>
              </div>
              <div class="absolute inset-0 border-2 border-[#C5A300] rounded-lg opacity-0 peer-checked:opacity-100 transition-opacity"></div>
            </label>

            <label class="relative flex items-center p-3 bg-white dark:bg-[#0F0F0F] border-2 border-gray-300 dark:border-[#2E2E2E] rounded-lg cursor-pointer hover:border-[#C5A300] transition-all">
              <%= f.radio_button :role, 'admin', class: "peer sr-only" %>
              <div class="flex items-center gap-3 w-full">
                <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg flex items-center justify-center text-white flex-shrink-0">
                  <i class="fas fa-user-shield"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <span class="block text-sm font-bold text-gray-900 dark:text-white">Administrador</span>
                  <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Acesso total</span>
                </div>
              </div>
              <div class="absolute inset-0 border-2 border-[#C5A300] rounded-lg opacity-0 peer-checked:opacity-100 transition-opacity"></div>
            </label>

            <label class="relative flex items-center p-3 bg-white dark:bg-[#0F0F0F] border-2 border-gray-300 dark:border-[#2E2E2E] rounded-lg cursor-pointer hover:border-[#C5A300] transition-all">
              <%= f.radio_button :role, 'financeiro', class: "peer sr-only" %>
              <div class="flex items-center gap-3 w-full">
                <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center text-white flex-shrink-0">
                  <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <span class="block text-sm font-bold text-gray-900 dark:text-white">Financeiro</span>
                  <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Gestão financeira</span>
                </div>
              </div>
              <div class="absolute inset-0 border-2 border-[#C5A300] rounded-lg opacity-0 peer-checked:opacity-100 transition-opacity"></div>
            </label>

            <label class="relative flex items-center p-3 bg-white dark:bg-[#0F0F0F] border-2 border-gray-300 dark:border-[#2E2E2E] rounded-lg cursor-pointer hover:border-[#C5A300] transition-all">
              <%= f.radio_button :role, 'atendente', class: "peer sr-only" %>
              <div class="flex items-center gap-3 w-full">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center text-white flex-shrink-0">
                  <i class="fas fa-headset"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <span class="block text-sm font-bold text-gray-900 dark:text-white">Atendente</span>
                  <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Atendimento</span>
                </div>
              </div>
              <div class="absolute inset-0 border-2 border-[#C5A300] rounded-lg opacity-0 peer-checked:opacity-100 transition-opacity"></div>
            </label>
          </div>
          <% if @user.errors[:role].any? %>
            <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:role].first %></p>
          <% end %>
        </div>

        <div class="pt-6 border-t border-gray-200 dark:border-[#2E2E2E]">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Definir Senha</h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2 bg-white dark:bg-[#0F0F0F] border border-gray-300 dark:border-[#2E2E2E] rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-[#C5A300] focus:border-transparent transition-all", placeholder: "••••••••", required: true %>
              <% if @user.errors[:password].any? %>
                <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:password].first %></p>
              <% end %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirmar Senha", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 bg-white dark:bg-[#0F0F0F] border border-gray-300 dark:border-[#2E2E2E] rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-[#C5A300] focus:border-transparent transition-all", placeholder: "••••••••", required: true %>
              <% if @user.errors[:password_confirmation].any? %>
                <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= @user.errors[:password_confirmation].first %></p>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex gap-4 justify-end pt-6">
          <%= link_to "Cancelar", configuracoes_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-gray-200 dark:bg-[#2E2E2E] text-gray-700 dark:text-gray-300 font-semibold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-300 dark:hover:bg-[#3E3E3E] transition-all transform hover:scale-105" %>
          <%= f.submit "Criar Usuário", class: "inline-flex items-center gap-2 px-6 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer" %>
        </div>

      <% end %>
    </div>
  </div>
</div>