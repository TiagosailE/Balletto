<header class="bg-white dark:bg-black text-[#2A2F33] dark:text-white shadow-md w-full fixed top-0 left-0 z-50 border-b border-[#F0E9DF] dark:border-[#2E2E2E]">
  <nav class="px-6 h-14 flex items-center justify-between">
    <span class="text-2xl font-extrabold tracking-wider text-[#B88B00]">BALLETTO</span>
    <div class="flex items-center gap-3">
      <%= link_to configuracoes_path, class: "text-[#6B747A] dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] transition-colors" do %>
        <i class="fas fa-cog text-xl"></i>
      <% end %>
      <%= render 'shared/theme_toggle' %>
