<div id="confirm-modal" class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-[10000] transition-opacity duration-300 p-4">
  
  <div class="bg-[#1C1C1C] rounded-xl shadow-xl border border-[#C5A300] w-11/12 max-w-md p-6 relative text-center">
    
    <h2 id="confirm-title" class="text-2xl font-bold text-[#C5A300] mb-4">Confirmar Ação</h2>
    
    <p id="confirm-body" class="text-gray-300 text-sm mb-8">
      Você tem certeza?
    </p>

    <div class="flex justify-center gap-4">
      <button id="confirm-cancel" class="px-6 py-2 bg-gray-700 text-white rounded-md hover:bg-gray-600 transition-all">
        Cancelar
      </button>
      
      <button id="confirm-proceed" class="px-6 py-2 bg-red-600 border border-red-700 text-white rounded-md hover:bg-red-500 transition-all">
        Excluir
      </button>
    </div>
  </div>

</div>