<footer class="bg-white dark:bg-[#121212] shadow-lg w-full flex-shrink-0 fixed bottom-0 left-0 z-50 border-t border-[#F0E9DF] dark:border-[#2E2E2E]">
 <nav class="flex justify-around md:justify-center md:gap-x-10 items-center h-12 md:h-auto md:py-2 px-4">
   <%= link_to root_path,
     class:"flex flex-col md:flex-row md:gap-x-2 items-center text-[#6B747A] dark:text-gray-300 hover:text-[#B88B00] transition-colors p-2 rounded-lg #{'font-bold text-[#B88B00]' if current_page?(root_path)}" do %>
       <i class="fas fa-home text-lg md:text-base"></i>
       <span class="text-xs md:text-sm font-medium">Início</span>
    <% end %>

    <%= link_to alunos_path,
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-[#6B747A] dark:text-gray-300 hover:text-[#B88B00] transition-colors p-2 rounded-lg #{'font-bold text-[#B88B00]' if current_page?(alunos_path)}" do %>
        <i class="fas fa-users text-lg md:text-base"></i>
       <span class="text-xs md:text-sm font-medium">Alunos</span>
    <% end %>

    <%= link_to '#',
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-[#6B747A] dark:text-gray-300 hover:text-[#B88B00] transition-colors p-2 rounded-lg" do %>
        <i class="fas fa-wallet text-lg md:text-base"></i>
        <span class="text-xs md:text-sm font-medium">Financeiro</span>
    <% end %>
    <%= link_to turmas_path,
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-[#6B747A] dark:text-gray-300 hover:text-[#B88B00] transition-colors p-2 rounded-lg #{'font-bold text-[#B88B00]' if current_page?(turmas_path)}" do %>
        <i class="fas fa-layer-group text-lg md:text-base"></i>
        <span class="text-xs md:text-sm font-medium">Turmas</span>
    <% end %>
  </nav>

  <div class="hidden md:block text-center text-[#6B747A] dark:text-gray-400 text-xs pb-2">
     &copy; <%= Time.current.year %> Balletto.
  </div>
</footer>