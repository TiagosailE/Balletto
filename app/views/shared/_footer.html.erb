<footer class="bg-black text-white w-full flex-shrink-0 fixed bottom-0 left-0 z-50 border-t border-[#2E2E2E]">
  <nav class="flex justify-around md:justify-center md:gap-x-10 items-center h-12 md:h-auto md:py-2 px-4">
    <%= link_to root_path,
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-gray-400 hover:text-[#C5A300] transition-colors p-2 rounded-lg #{'font-bold text-[#C5A300]' if current_page?(root_path)}" do %>
      <i class="fas fa-home text-lg md:text-base"></i>
      <span class="text-xs md:text-sm font-medium">Início</span>
    <% end %>

    <%= link_to '#',
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-gray-400 hover:text-[#C5A300] transition-colors p-2 rounded-lg" do %>
      <i class="fas fa-users text-lg md:text-base"></i>
      <span class="text-xs md:text-sm font-medium">Alunos</span>
    <% end %>

    <%= link_to '#',
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-gray-400 hover:text-[#C5A300] transition-colors p-2 rounded-lg" do %>
      <i class="fas fa-wallet text-lg md:text-base"></i>
      <span class="text-xs md:text-sm font-medium">Financeiro</span>
    <% end %>

    <%= link_to turmas_path,
      class:"flex flex-col md:flex-row md:gap-x-2 items-center text-[#C5A300] font-bold md:font-medium transition-colors p-2 rounded-lg #{'text-[#C5A300]' if current_page?(turmas_path)}" do %>
      <i class="fas fa-layer-group text-lg md:text-base"></i>
      <span class="text-xs md:text-sm">Turmas</span>
    <% end %>
  </nav>

  <div class="hidden md:block text-center text-gray-500 text-xs pb-2">
    &copy; <%= Time.current.year %> Balletto.
  </div>
</footer>
