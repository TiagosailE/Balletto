<footer class="bg-white dark:bg-[#121212] shadow-lg w-full flex-shrink-0 fixed bottom-0 left-0 z-50 border-t border-gray-200 dark:border-[#2E2E2E]">
  <nav class="flex justify-around md:justify-center md:gap-x-8 items-center h-14 md:h-auto md:py-2 px-4">

    <%= link_to root_path,
      class: "group flex flex-col md:flex-row md:gap-x-2 items-center justify-center p-2 rounded-xl transition-all duration-300 #{current_page?(root_path) ? 'text-[#C5A300] dark:text-[#D4AF37]' : 'text-[#6B747A] dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] hover:bg-gray-50 dark:hover:bg-[#1A1A1A]'}" do %>
      <div class="relative">
        <i class="fas fa-home text-xl md:text-lg transition-transform duration-300 group-hover:scale-110"></i>
        <% if current_page?(root_path) %>
          <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-[#C5A300] rounded-full"></div>
        <% end %>
      </div>
      <span class="text-xs md:text-sm font-medium mt-1 md:mt-0 <%= 'font-bold' if current_page?(root_path) %>">Início</span>
    <% end %>

    <%= link_to alunos_path,
      class: "group flex flex-col md:flex-row md:gap-x-2 items-center justify-center p-2 rounded-xl transition-all duration-300 #{current_page?(alunos_path) ? 'text-[#C5A300] dark:text-[#D4AF37]' : 'text-[#6B747A] dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] hover:bg-gray-50 dark:hover:bg-[#1A1A1A]'}" do %>
      <div class="relative">
        <i class="fas fa-users text-xl md:text-lg transition-transform duration-300 group-hover:scale-110"></i>
        <% if current_page?(alunos_path) %>
          <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-[#C5A300] rounded-full"></div>
        <% end %>
      </div>
      <span class="text-xs md:text-sm font-medium mt-1 md:mt-0 <%= 'font-bold' if current_page?(alunos_path) %>">Alunos</span>
    <% end %>

    <%= link_to '#',
      class: "group flex flex-col md:flex-row md:gap-x-2 items-center justify-center p-2 rounded-xl transition-all duration-300 text-[#6B747A] dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] hover:bg-gray-50 dark:hover:bg-[#1A1A1A]" do %>
      <div class="relative">
        <i class="fas fa-wallet text-xl md:text-lg transition-transform duration-300 group-hover:scale-110"></i>
      </div>
      <span class="text-xs md:text-sm font-medium mt-1 md:mt-0">Financeiro</span>
    <% end %>

    <%= link_to turmas_path,
      class: "group flex flex-col md:flex-row md:gap-x-2 items-center justify-center p-2 rounded-xl transition-all duration-300 #{current_page?(turmas_path) ? 'text-[#C5A300] dark:text-[#D4AF37]' : 'text-[#6B747A] dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] hover:bg-gray-50 dark:hover:bg-[#1A1A1A]'}" do %>
      <div class="relative">
        <i class="fas fa-layer-group text-xl md:text-lg transition-transform duration-300 group-hover:scale-110"></i>
        <% if current_page?(turmas_path) %>
          <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-[#C5A300] rounded-full"></div>
        <% end %>
      </div>
      <span class="text-xs md:text-sm font-medium mt-1 md:mt-0 <%= 'font-bold' if current_page?(turmas_path) %>">Turmas</span>
    <% end %>

    <%= link_to eventos_path,
      class: "group flex flex-col md:flex-row md:gap-x-2 items-center justify-center p-2 rounded-xl transition-all duration-300 #{current_page?(eventos_path) ? 'text-[#C5A300] dark:text-[#D4AF37]' : 'text-[#6B747A] dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] hover:bg-gray-50 dark:hover:bg-[#1A1A1A]'}" do %>
      <div class="relative">
        <i class="fas fa-calendar-alt text-xl md:text-lg transition-transform duration-300 group-hover:scale-110"></i>
        <% if current_page?(eventos_path) %>
          <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-[#C5A300] rounded-full"></div>
        <% end %>
      </div>
      <span class="text-xs md:text-sm font-medium mt-1 md:mt-0 <%= 'font-bold' if current_page?(eventos_path) %>">Eventos</span>
    <% end %>

  </nav>

  <div class="hidden md:block text-center text-gray-500 dark:text-gray-500 text-xs pb-2">
    &copy; <%= Time.current.year %> Balletto - Todos os direitos reservados
  </div>
</footer>