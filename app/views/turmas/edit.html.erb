<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <div class="text-center mb-6">
    <h1 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">
      Editar Turma
    </h1>
    <p class="mt-3 max-w-xl mx-auto text-lg text-gray-400">
      Ajuste os detalhes da turma "<%= @turma.tur_nome %>" abaixo.
    </p>
  </div>

  <div class="bg-gray-100 dark:bg-[#1C1C1C] rounded-2xl shadow-lg border border-gray-200 dark:border-[#2E2E2E] p-5 mb-8 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <i class="fas fa-calendar-alt w-6 text-center text-2xl text-gray-500"></i>
      <div>
        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Horário</h3>
        <p class="text-lg font-semibold text-gray-900 dark:text-[#E5E5E5]">
          <% if @turma.tur_dia_da_semana.present? && @turma.tur_horario.present? %>
            <%= Array(@turma.tur_dia_da_semana).reject(&:blank?).join(', ') %>, <%= @turma.tur_horario.strftime('%H:%M') %>
          <% elsif @turma.tur_horario.present? %>
            <%= @turma.tur_horario.strftime('%H:%M') %>
          <% else %>
            A definir
          <% end %>
        </p>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <i class="fas fa-users w-6 text-center text-2xl text-[#C5A300]"></i>
      <div class="text-right">
        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Vagas</h3>
        <p class="text-lg font-semibold text-gray-900 dark:text-[#E5E5E5]"><%= @turma.vagas_info %></p>
      </div>
    </div>
  </div>

  <%= render 'form', turma: @turma %>
</div>