<div class="w-full max-w-screen-2xl mx-auto">
  <div class="text-center mb-10">
    <h2 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">Gestão de Turmas</h2>
    <p class="mt-4 max-w-2xl mx-auto text-lg text-gray-400">
      Organize, crie e gerencie todas as suas turmas em um só lugar.
    </p>
  </div>

  <div class="flex flex-col md:flex-row md:gap-8 items-start justify-center">
    <aside class="w-full md:w-auto mb-6 md:mb-0 flex justify-center md:block">
      <%= link_to new_turma_path,
        class: "inline-flex justify-center items-center gap-2 px-6 py-3 bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Criar Nova Turma</span>
      <% end %>
    </aside>

    <div class="flex-1 w-full">
      <div id="turmas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
        <% if @turmas.blank? %>
          <div class="col-span-full bg-[#1C1C1C] rounded-2xl shadow p-8 text-center text-gray-400 border border-[#2E2E2E]">
            <i class="fas fa-layer-group text-4xl mb-4 text-gray-500"></i>
            <h3 class="text-lg font-semibold text-[#E5E5E5]">Nenhuma turma encontrada</h3>
            <p class="mt-1">Clique em "Criar Nova Turma" para começar a cadastrar.</p>
          </div>
        <% else %>
          <% @turmas.each do |turma| %>
            <div 
              class="bg-[#1C1C1C] rounded-2xl shadow-lg overflow-hidden transform hover:-translate-y-1 transition-transform duration-300 ease-in-out border border-[#2E2E2E] flex flex-col w-full h-full hover:border-[#C5A300] cursor-pointer"
              onclick="openModal('<%= turma.tur_nome %>')"
            >
              <div class="p-5 flex-grow">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-bold text-[#E5E5E5]"><%= turma.tur_nome %></h3>
                  <%
                    alunos_count = turma.alunos.count
                    capacidade = turma.tur_capacidade || 0
                    status_text = 'Vagas Abertas'
                    status_color = 'yellow'
                    if alunos_count >= capacidade && capacidade > 0
                      status_text = 'Lotada'
                      status_color = 'red'
                    elsif alunos_count > 0
                      status_text = 'Ativa'
                      status_color = 'teal'
                    end
                  %>
                  <span class="px-2 py-0.5 text-xs font-medium text-<%= status_color %>-800 bg-<%= status_color %>-100 rounded-full whitespace-nowrap">
                    <%= status_text %>
                  </span>
                </div>

                <div class="space-y-3 text-sm text-gray-400">
                  <div class="flex items-center">
                    <i class="fas fa-calendar-alt w-5 text-center text-gray-500 mr-3"></i>
                    <span><%= turma.tur_dia_da_semana %>, <%= turma.tur_horario&.strftime("%H:%M") %></span>
                  </div>
                  <div class="flex items-center">
                    <i class="fas fa-user-tie w-5 text-center text-gray-500 mr-3"></i>
                    <span>
                      <% if turma.professor.present? %>
                        <%= turma.professor.nome %>
                      <% else %>
                        Professor(a) a definir
                      <% end %>
                    </span>
                  </div>
                </div>
              </div>
              
              <div class="bg-[#111111] px-5 py-3 border-t border-[#2E2E2E] flex items-center justify-between text-sm">
                
                <div class="flex items-center gap-2 text-gray-400">
                  <i class="fas fa-users text-[#C5A300]"></i>
                  <span class="font-semibold text-[#E5E5E5]"><%= turma.alunos.count %> / <%= turma.tur_capacidade %></span>
                  <span class="text-gray-500">alunos</span>
                </div>

                <div class="flex items-center gap-4">
                  
                  <%= link_to "Editar →", edit_turma_path(turma), 
                        class: "font-semibold text-[#C5A300] hover:text-[#D4AF37] transition-colors", 
                        data: { turbo: false },
                        onclick: "event.stopPropagation()" %>

                  <button 
                    type="button"
                    class="text-gray-500 hover:text-red-500 transition-colors"
                    title="Excluir Turma"
                    data-confirm-modal="true"
                    data-confirm-title="Excluir Turma"
                    data-confirm-body="Tem certeza que deseja excluir a turma '<%= turma.tur_nome %>'? Esta ação não pode ser desfeita."
                    data-confirm-path="<%= turma_path(turma) %>"
                    data-confirm-text="Excluir"
                    data-confirm-class="bg-red-600 hover:bg-red-500"
                    onclick="event.stopPropagation()">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>

              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<%= render 'modal' %>
