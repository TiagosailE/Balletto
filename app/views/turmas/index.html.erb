<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestão de Turmas - Balletto</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>

<body class="bg-gray-50 antialiased pb-20 md:pb-0">

  <div id="balletto-app" class="min-h-screen flex flex-col">
    
    <header class="bg-[#0A1E3F] text-white shadow-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center h-16">
          <span class="text-2xl font-bold tracking-wider">BALLETTO</span>
        </div>
      </div>
    </header>

    <main id="balletto-main" class="flex-grow w-full">
      <div class="px-4 sm:px-6 lg:px-8 py-10">

        <div class="text-center mb-10">
          <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">
            Gestão de Turmas
          </h2>
          <p class="mt-4 max-w-3xl mx-auto text-lg text-gray-500">
            Organize, crie e gerencie todas as suas turmas em um só lugar.
          </p>
        </div>

        <div class="max-w-7xl mx-auto md:flex md:gap-8">
            
            <aside class="w-full md:w-64 mb-8 md:mb-0">
                <%= link_to new_turma_path,
                  class: "w-full inline-flex justify-center items-center gap-2 px-6 py-3 bg-[#0A1E3F] text-white font-bold rounded-lg shadow-md hover:bg-[#183261] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#0A1E3F] transition-all transform hover:scale-105" do %>
                  <i class="fas fa-plus"></i>
                  <span>Criar Nova Turma</span>
                <% end %>
            </aside>
            
            <div class="flex-1">
              <div id="turmas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                
                <% if @turmas.empty? %>
                  <div class="col-span-full bg-white rounded-2xl shadow p-8 text-center text-gray-500">
                    <i class="fas fa-layer-group text-4xl mb-4 text-gray-300"></i>
                    <h3 class="text-lg font-semibold text-gray-700">Nenhuma turma encontrada</h3>
                    <p class="mt-1">Clique em "Criar Nova Turma" para começar a cadastrar.</p>
                  </div>
                <% else %>
                  <% @turmas.each do |turma| %>
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden transform hover:-translate-y-1 transition-transform duration-300 ease-in-out border border-gray-100 flex flex-col">
                      <div class="p-5 flex-grow">
                        <div class="flex items-center justify-between mb-4">
                          <h3 class="text-lg font-bold text-gray-800"><%= turma.tur_nome %></h3>

                          <%
                            alunos_count = turma.alunos.count
                            capacidade = turma.tur_capacidade
                            status_text = 'Inscrições Abertas'
                            status_color = 'yellow'
                            if alunos_count >= capacidade
                              status_text = 'Lotada'
                              status_color = 'red'
                            elsif alunos_count > 0
                              status_text = 'Ativa'
                              status_color = 'teal'
                            end
                          %>
                          <span class="px-3 py-1 text-xs font-semibold text-<%= status_color %>-800 bg-<%= status_color %>-100 rounded-full"><%= status_text %></span>

                        </div>
                        <div class="space-y-3 text-sm text-gray-600">
                          <div class="flex items-center">
                            <i class="fas fa-certificate w-5 text-center text-gray-400 mr-3"></i>
                            <span>Nível: <%= turma.tur_nivel %></span>
                          </div>
                          <div class="flex items-center">
                            <i class="fas fa-calendar-alt w-5 text-center text-gray-400 mr-3"></i>
                            <span><%= turma.tur_dia_da_semana %>, <%= turma.tur_horario %></span>
                          </div>
                          <div class="flex items-center">
                              <i class="fas fa-user-tie w-5 text-center text-gray-400 mr-3"></i>
                              <span>Professor(a) a definir</span>
                          </div>
                        </div>
                      </div>
                      <div class="bg-gray-50 px-5 py-3 border-t border-gray-100">
                        <div class="flex items-center justify-between text-sm">
                          <div class="flex items-center gap-2 text-gray-700">
                            <i class="fas fa-users"></i>
                            <span class="font-semibold"><%= turma.alunos.count %> / <%= turma.tur_capacidade %></span>
                            <span class="text-gray-500">alunos</span>
                          </div>
                          <%= link_to 'Detalhes &rarr;'.html_safe, turma_path(turma), class: "font-semibold text-blue-600 hover:text-blue-800 transition-colors" %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                <% end %>

              </div>
            </div>
        </div>

      </div>
    </main>

    <footer class="bg-white md:bg-[#0A1E3F] shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] md:shadow-none w-full mt-auto fixed bottom-0 left-0 z-50 md:relative">
      <nav class="flex justify-around md:justify-center md:gap-x-10 items-center max-w-7xl mx-auto h-16 md:h-auto md:py-4 px-4">
        
        <%= link_to root_path, class: "flex flex-col md:flex-row md:gap-x-2 items-center text-gray-500 md:text-gray-300 md:hover:bg-gray-700 hover:text-blue-600 md:hover:text-white transition-colors p-2 rounded-lg" do %>
          <i class="fas fa-home text-xl md:text-base"></i>
          <span class="text-xs md:text-sm font-medium">Início</span>
        <% end %>
        
        <%= link_to '#', class: "flex flex-col md:flex-row md:gap-x-2 items-center text-gray-500 md:text-gray-300 md:hover:bg-gray-700 hover:text-blue-600 md:hover:text-white transition-colors p-2 rounded-lg" do %>
          <i class="fas fa-users text-xl md:text-base"></i>
          <span class="text-xs md:text-sm font-medium">Alunos</span>
        <% end %>

        <%= link_to '#', class: "flex flex-col md:flex-row md:gap-x-2 items-center text-gray-500 md:text-gray-300 md:hover:bg-gray-700 hover:text-blue-600 md:hover:text-white transition-colors p-2 rounded-lg" do %>
          <i class="fas fa-wallet text-xl md:text-base"></i>
          <span class="text-xs md:text-sm font-medium">Financeiro</span>
        <% end %>

        <%= link_to turmas_path, class: "flex flex-col md:flex-row md:gap-x-2 items-center text-blue-600 md:text-white font-bold md:font-medium md:bg-blue-600 transition-colors p-2 rounded-lg" do %>
          <i class="fas fa-layer-group text-xl md:text-base"></i>
          <span class="text-xs md:text-sm">Turmas</span>
        <% end %>

      </nav>
      <div class="hidden md:block text-center text-gray-400 text-xs pb-3">
          &copy; <%= Time.current.year %> Balletto. Todos os direitos reservados.
      </div>
    </footer>

  </div>

</body>
</html>

