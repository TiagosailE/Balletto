<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <%# --- CABEÇALHO PADRONIZADO --- %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
        <div class="w-12 h-12 bg-gradient-to-br from-[#C5A300] to-[#B88B00] rounded-xl flex items-center justify-center shadow-lg shadow-yellow-500/20">
          <i class="fas fa-chalkboard-teacher text-white text-xl"></i>
        </div>
        Gerenciar Turmas
      </h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2 ml-15">
        <%= @turmas.count %> <%= @turmas.count == 1 ? 'turma encontrada' : 'turmas encontradas' %>
      </p>
    </div>

    <%= link_to new_turma_path, class: "group inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-[#C5A300] to-[#D4AF37] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200" do %>
      <i class="fas fa-plus group-hover:rotate-90 transition-transform duration-200"></i>
      <span class="hidden sm:inline">Criar Nova Turma</span>
      <span class="sm:hidden">Nova Turma</span>
    <% end %>
  </div>

  <%# --- CONTEÚDO PRINCIPAL --- %>
  
  <% if @turmas.empty? %>
    <%# --- EMPTY STATE (PADRÃO) --- %>
    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg border border-gray-200 dark:border-[#2E2E2E] p-12 text-center">
      <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-[#0F0F0F] dark:to-[#1A1A1A] rounded-full flex items-center justify-center">
        <i class="fas fa-layer-group text-3xl text-gray-400 dark:text-gray-600"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
        Nenhuma turma encontrada
      </h3>
      <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">
        Comece criando sua primeira turma para matricular alunos.
      </p>
      <%= link_to new_turma_path, class: "inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-[#C5A300] to-[#D4AF37] text-white font-semibold rounded-xl shadow-lg" do %>
        <i class="fas fa-plus"></i>
        <span>Criar Primeira Turma</span>
      <% end %>
    </div>

  <% else %>
    <%# --- GRID DE TURMAS --- %>
    <div id="turmas-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <% @turmas.each do |turma| %>
        <% 
           alunos_count = turma.alunos.count
           capacidade = turma.tur_capacidade || 0
           
           # Lógica de Status Visual
           if alunos_count >= capacidade && capacidade > 0
             status_text = 'Lotada'
             status_classes = 'bg-red-100 text-red-700 border-red-200 dark:bg-red-900/30 dark:text-red-300 dark:border-red-800'
             progress_color = 'bg-red-500'
           elsif alunos_count == 0
             status_text = 'Vazia'
             status_classes = 'bg-gray-100 text-gray-600 border-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700'
             progress_color = 'bg-gray-400'
           else
             status_text = 'Vagas Abertas'
             status_classes = 'bg-green-100 text-green-700 border-green-200 dark:bg-green-900/30 dark:text-green-300 dark:border-green-800'
             progress_color = 'bg-[#C5A300]'
           end
           
           # Cálculo da porcentagem para barra de progresso
           percent = capacidade > 0 ? (alunos_count.to_f / capacidade * 100).to_i : 0
        %>

        <div 
          class="group bg-white dark:bg-[#1C1C1C] rounded-xl shadow-lg border border-gray-200 dark:border-[#2E2E2E] hover:shadow-xl hover:scale-[1.02] transition-all duration-200 flex flex-col h-full cursor-pointer relative overflow-hidden"
          data-turma-id="<%= turma.tur_codigo %>"
          data-turma-nome="<%= turma.tur_nome %>"
          onclick="abrirModalAlunos(this)"
        >
          <%# Topo Decorativo (Barra de status) %>
          <div class="absolute top-0 left-0 w-full h-1 bg-gray-100 dark:bg-[#2E2E2E]">
            <div class="h-full <%= progress_color %> transition-all duration-500" style="width: <%= percent %>%"></div>
          </div>

          <div class="p-6 flex-grow">
            <%# --- AQUI ESTÁ A CORREÇÃO --- %>
            <div class="flex items-start justify-between gap-3 mb-4">
              <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-[#C5A300] transition-colors break-words">
                <%= turma.tur_nome %>
              </h3>
              <%# Adicionado whitespace-nowrap e flex-shrink-0 para garantir que o badge nunca quebre ou esprema %>
              <span class="flex-shrink-0 whitespace-nowrap px-2.5 py-1 text-xs font-bold rounded-full border <%= status_classes %>">
                <%= status_text %>
              </span>
            </div>

            <div class="space-y-3">
              <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                <div class="w-8 flex justify-center">
                  <i class="fas fa-calendar-alt text-[#C5A300]"></i>
                </div>
                <span>
                  <%= Array(turma.tur_dia_da_semana).reject(&:blank?).join(', ') %>
                  <% if turma.tur_horario %>
                    • <%= turma.tur_horario.strftime("%H:%M") %>
                  <% end %>
                </span>
              </div>

              <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                <div class="w-8 flex justify-center">
                  <i class="fas fa-user-tie text-[#C5A300]"></i>
                </div>
                <span><%= turma.professor&.usu_nome || 'Sem professor' %></span>
              </div>
            </div>
          </div>

          <%# Rodapé do Card (Info de Alunos e Ações) %>
          <div class="bg-gray-50 dark:bg-[#111111] px-5 py-3 border-t border-gray-200 dark:border-[#2E2E2E] flex items-center justify-between mt-auto">
            
            <div class="flex items-center gap-2">
              <i class="fas fa-users text-gray-400 dark:text-gray-500"></i>
              <span class="text-sm font-bold text-gray-900 dark:text-white">
                <%= alunos_count %> <span class="text-gray-400 text-xs font-normal">/ <%= capacidade %></span>
              </span>
            </div>

            <div class="flex items-center gap-3">
              <%= link_to edit_turma_path(turma),
                  class: "text-gray-500 hover:text-[#C5A300] dark:text-gray-400 dark:hover:text-[#C5A300] transition-colors p-1",
                  title: "Editar Turma",
                  data: { turbo: false },
                  onclick: "event.stopPropagation()" do %>
                <i class="fas fa-pencil-alt"></i>
              <% end %>

              <button 
                type="button"
                class="text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-500 transition-colors p-1"
                title="Excluir Turma"
                data-confirm-modal="true"
                data-confirm-title="Excluir Turma"
                data-confirm-body="Tem certeza que deseja excluir a turma '<%= turma.tur_nome %>'? Isso não apagará os alunos, apenas o vínculo."
                data-confirm-path="<%= turma_path(turma) %>"
                data-confirm-text="Excluir"
                data-confirm-class="bg-red-600 hover:bg-red-500"
                onclick="event.stopPropagation()">
                <i class="fas fa-trash-alt"></i>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= render 'modal' %>