<div class="w-full max-w-screen-2xl mx-auto">
  <div class="text-center mb-10">
    <h2 class="text-4xl font-extrabold text-gray-900 sm:text-5xl">
      Gestão de Turmas
    </h2>
    <p class="mt-4 max-w-2xl mx-auto text-lg text-gray-500">
      Organize, crie e gerencie todas as suas turmas em um só lugar.
    </p>
  </div>

  <div class="flex flex-col md:flex-row md:gap-8 items-start justify-center">
    <aside class="w-full md:w-auto mb-6 md:mb-0 flex justify-center md:block">
      <%= link_to new_turma_path,
        class: "inline-flex justify-center items-center gap-2 px-6 py-3 bg-[#0A1E3F] text-white font-bold rounded-lg shadow-md hover:bg-[#183261] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#0A1E3F] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Criar Nova Turma</span>
      <% end %>
    </aside>
    <div class="flex-1 w-full">
      <div
        id="turmas-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch"
      >
        <% if @turmas.blank? %>
          <div class="col-span-full bg-white rounded-2xl shadow p-8 text-center text-gray-500">
            <i class="fas fa-layer-group text-4xl mb-4 text-gray-300"></i>
            <h3 class="text-lg font-semibold text-gray-700">
              Nenhuma turma encontrada
            </h3>
            <p class="mt-1">
              Clique em "Criar Nova Turma" para começar a cadastrar.
            </p>
          </div>
        <% else %>
          <% @turmas.each do |turma| %>
            <%= link_to edit_turma_path(turma), class: "block h-full no-underline" do %>
              <div class="bg-white rounded-2xl shadow-lg overflow-hidden transform hover:-translate-y-1 transition-transform duration-300 ease-in-out border border-gray-100 flex flex-col w-full h-full">
                <div class="p-5 flex-grow">
                  <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold text-gray-800">
                      <%= turma.tur_nome %>
                    </h3>
                    
                    <%
                      alunos_count = turma.alunos.count
                      capacidade = turma.tur_capacidade
                      status_text = 'Vagas Abertas'
                      status_color = 'yellow'
                      if alunos_count >= capacidade
                        status_text = 'Lotada'
                        status_color = 'red'
                      elsif alunos_count > 0
                        status_text = 'Ativa'
                        status_color = 'teal'
                      end
                    %>
                    <span class="px-2 py-0.5 text-xs font-medium text-<%= status_color %>-800 bg-<%= status_color %>-100 rounded-full whitespace-nowrap">
                      <%= status_text %>
                    </span>
                  </div>
                  <div class="space-y-3 text-sm text-gray-600">
                    <div class="flex items-center">
                      <i class="fas fa-certificate w-5 text-center text-gray-400 mr-3"></i>
                      <span>Nível: <%= turma.tur_nivel %></span>
                    </div>
                    <div class="flex items-center">
                      <i class="fas fa-calendar-alt w-5 text-center text-gray-400 mr-3"></i>
                      <span><%= turma.tur_dia_da_semana %>, <%= turma.tur_horario&.strftime("%H:%M") %></span>
                    </div>
                    <div class="flex items-center">
                      <i class="fas fa-user-tie w-5 text-center text-gray-400 mr-3"></i>
                      <span>
                        <% if turma.professor.present? %>
                          <%= turma.professor.nome %>
                        <% else %>
                          Professor(a) a definir
                        <% end %>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="bg-gray-50 px-5 py-3 border-t border-gray-100">
                  <div class="flex items-center justify-between text-sm flex-wrap">
                    <div class="flex items-center gap-2 text-gray-700">
                      <i class="fas fa-users"></i>
                      <span class="font-semibold"><%= turma.alunos.count %> / <%= turma.tur_capacidade %></span>
                      <span class="text-gray-500">alunos</span>
                    </div>
                    <span class="font-semibold text-blue-600">Editar &rarr;</span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

