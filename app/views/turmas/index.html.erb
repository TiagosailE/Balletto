<div class="w-full max-w-screen-2xl mx-auto">
  <div class="text-center mb-10">
    <h2 class="text-4xl font-extrabold text-[#B88B00] sm:text-5xl transition-colors duration-200">Gestão de Turmas</h2>
    <p class="mt-4 max-w-2xl mx-auto text-lg text-[#6B747A] dark:text-gray-400 transition-colors duration-200">
      Organize, crie e gerencie todas as suas turmas em um só lugar.
    </p>
  </div>
  <div class="w-full flex flex-col items-center justify-center">
    <aside class="w-full md:w-auto mb-8 flex justify-center">
      <%= link_to new_turma_path,
        class: "inline-flex justify-center items-center gap-2 px-6 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Criar Nova Turma</span>
      <% end %>
    </aside>
    <div class="w-full">
      <% if @turmas.blank? %>
        <div class="w-full text-center p-8">
          <i class="fas fa-layer-group text-4xl mb-4 text-gray-400 dark:text-gray-600"></i>
          <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-300">Nenhuma turma encontrada</h3>
          <p class="mt-1 text-gray-500 dark:text-gray-400">Clique em "Criar Nova Turma" para começar a cadastrar.</p>
        </div>
      <% else %>
        <div id="turmas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
          <% @turmas.each do |turma| %>
  <% 
    alunos_count = turma.alunos.count
    capacidade = turma.tur_capacidade || 0
    status_text = 'Vagas Abertas'
    status_color = 'yellow'

    if alunos_count >= capacidade && capacidade > 0
      status_text = 'Lotada'
      status_color = 'red'
    elsif alunos_count > 0
      status_text = 'Ativa'
      status_color = 'teal'
    end
  %>
  <div 
    class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg overflow-hidden border border-gray-200 dark:border-[#2E2E2E] flex flex-col w-full h-full hover:border-[#C5A300] hover:-translate-y-1 transition-all duration-300 ease-in-out cursor-pointer"
    data-turma-id="<%= turma.tur_codigo %>"
    data-turma-nome="<%= turma.tur_nome %>"
    onclick="abrirModalAlunos(this)"
  >
    <div class="p-5 flex-grow">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-[#2A2F33] dark:text-[#E5E5E5]"><%= turma.tur_nome %></h3>
        <span class="border border-<%= status_color %>-300 px-2 py-0.5 text-xs font-medium text-<%= status_color %>-800 bg-<%= status_color %>-100 rounded-full whitespace-nowrap">
          <%= status_text %>
        </span>
      </div>
      <div class="space-y-3 text-sm text-[#6B747A] dark:text-gray-400">
        <div class="flex items-center">
          <i class="fas fa-calendar-alt w-5 text-center text-[#8A939E] dark:text-gray-500 mr-3"></i>
          <span><%= Array(turma.tur_dia_da_semana).reject(&:blank?).join(', ') %>, <%= turma.tur_horario&.strftime("%H:%M") %></span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-user-tie w-5 text-center text-[#8A939E] dark:text-gray-500 mr-3"></i>
          <span><%= turma.professor.present? ? turma.professor.nome : 'Professor(a) a definir' %></span>
        </div>
      </div>
    </div>
    <div class="bg-gray-50 dark:bg-[#111111] px-5 py-3 border-t border-gray-200 dark:border-[#2E2E2E] flex items-center justify-between text-sm">
      <div class="flex items-center gap-2 text-[#6B747A] dark:text-gray-400">
        <i class="fas fa-users text-[#B88B00]"></i>
        <span class="font-semibold text-[#2A2F33] dark:text-[#E5E5E5]"><%= alunos_count %> / <%= capacidade %></span>
        <span class="text-[#6B747A] dark:text-gray-500">alunos</span>
      </div>
      <div class="flex items-center gap-4">
        <%= link_to edit_turma_path(turma),
          class: "inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105 text-xs",
          data: { turbo: false },
          onclick: "event.stopPropagation()" do %>
          <i class="fas fa-edit"></i>
          Editar
        <% end %>
        <button 
          type="button"
          class="text-[#6B747A] hover:text-[#CC4444] transition-colors"
          title="Excluir Turma"
          data-confirm-modal="true"
          data-confirm-title="Excluir Turma"
          data-confirm-body="Tem certeza que deseja excluir a turma '<%= turma.tur_nome %>'? Esta ação não pode ser desfeita."
          data-confirm-path="<%= turma_path(turma) %>"
          data-confirm-text="Excluir"
          data-confirm-class="bg-red-600 hover:bg-red-500"
          onclick="event.stopPropagation()">
          <i class="fas fa-trash-alt"></i>
        </button>
      </div>
    </div>
  </div>
<% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'modal' %>