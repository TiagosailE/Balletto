<div style="color-scheme: light dark;">
  <%= form_with(model: turma, local: true) do |f| %>
  <% if turma.errors.any? %>
    <div class="mb-4">
      <div class="text-red-600 font-medium">Erros:</div>
      <ul class="text-sm text-red-600">
        <% turma.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :user_id, 'Professor Responsável', class: 'block text-sm font-medium text-gray-700' %>
      
  <%= f.collection_select :user_id, 
    @professores, 
    :id, 
    :nome, 
    { include_blank: 'Nenhum (opcional)' },
    class: 'mt-1 block w-full border rounded-md px-3 py-2 text-gray-900',
    "data-color-scheme": 'light dark',
    style: 'color: rgb(17 24 39);' %>
    </div>
      
    <div>
      <%= f.label :tur_nome, 'Nome da Turma', class: 'block text-sm font-medium text-gray-700' %>
  <%= f.text_field :tur_nome, class: 'mt-1 block w-full border rounded-md px-3 py_2 text-gray-900', maxlength: 50, "data-color-scheme": 'light dark', style: 'color: rgb(17 24 39);' %>
    </div>

    <div>
      <%= f.label :tur_dia_da_semana, 'Dia da Semana', class: 'block text-sm font-medium text-gray-700' %>
      <%= f.select :tur_dia_da_semana, 
        ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'],
        { include_blank: 'Selecione' },
        class: 'mt-1 block w-full border rounded-md px-3 py-2 text-gray-900 appearance-none',
        "data-color-scheme": 'light dark', style: 'color: rgb(17 24 39);' %>
    </div>

    <div>
      <%= f.label :tur_horario, 'Horário', class: 'block text-sm font-medium text-gray-700' %>
    <%= f.time_field :tur_horario, 
      value: (turma.tur_horario&.strftime('%H:%M')), 
      class: 'mt-1 block w-full border rounded-md px-3 py-2 text-gray-900',
      "data-color-scheme": 'light dark', style: 'color: rgb(17 24 39);' %>
    </div>

    <div>
      <%= f.label :tur_capacidade, 'Capacidade', class: 'block text-sm font-medium text-gray-700' %>
  <%= f.number_field :tur_capacidade, class: 'mt-1 block w-36 border rounded-md px-3 py-2 text-gray-900', min: 1, max: 255, "data-color-scheme": 'light dark', style: 'color: rgb(17 24 39);' %>
    </div>

    <div class="pt-2">
      <%= f.submit class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700' %>
      <%= link_to 'Cancelar', turmas_path, class: 'ml-2 text-gray-600' %>
    </div>
  </div>
  <% end %>
</div>