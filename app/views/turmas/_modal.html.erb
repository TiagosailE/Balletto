<div id="alunos-modal" class="hidden fixed inset-0 flex items-center justify-center z-[9999] p-4">
  <div class="absolute inset-0 bg-black bg-opacity-50"></div>
  
  <div class="bg-white dark:bg-[#1C1C1C] rounded-xl shadow-xl border border-gray-200 dark:border-[#2E2E2E] w-11/12 max-w-2xl p-6 relative flex flex-col max-h-[85vh]">
    <button onclick="closeModal()" class="absolute top-3 right-3 text-gray-400 hover:text-[#C5A300] z-10">
      <i class="fas fa-times text-lg"></i>
    </button>

    <div class="flex-shrink-0 text-center">
      <h2 id="modal-turma-nome" class="text-2xl font-bold text-[#C5A300] mb-4">Turma</h2>
      <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">Alunos cadastrados nesta turma</p>
    </div>

    <div id="modal-alunos-container" class="flex-1 overflow-y-auto pr-3 grid grid-cols-2 sm:grid-cols-3 gap-4">
    </div>

    <div class="mt-6 flex-shrink-0 text-center">
      <button onclick="closeModal()" class="px-5 py-2 bg-white dark:bg-black border border-[#C5A300] text-[#C5A300] rounded-md hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37]">
        Fechar
      </button>
    </div>
  </div>
</div