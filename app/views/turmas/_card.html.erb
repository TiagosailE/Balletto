<div class="bg-white border rounded-lg p-4 shadow-sm hover:shadow-md transition duration-150">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-lg font-medium"><%= link_to turma.tur_nome, turma_path(turma), class: 'hover:underline' %></h2>
      <p class="text-sm text-gray-600 mt-1">
        <strong>Nível:</strong> <%= turma.tur_nivel.presence || '—' %>
      </p>
      <p class="text-sm text-gray-600 mt-1">
  <strong>Horário:</strong>
  <% if turma.tur_dia_da_semana.present? && turma.tur_horario.present? %>
    <%= turma.tur_dia_da_semana %>, <%= turma.tur_horario.strftime('%H:%M') %>
  <% elsif turma.tur_horario.present? %>
    <%= turma.tur_horario.strftime('%H:%M') %>
  <% else %>
    —
  <% end %>
</p>
    </div>

    <div class="text-right">
      <div class="text-sm text-gray-500">Vagas: <span class="font-semibold"><%= turma.vagas_info %></span></div>
      <div class="mt-3 flex gap-2">
        <%= link_to 'Editar', edit_turma_path(turma), class: 'text-sm px-3 py-1 border rounded text-gray-700 hover:bg-gray-50' %>
        <%= button_to 'Excluir', 
            turma_path(turma), 
            method: :delete,
            onclick: "return confirm('Você tem certeza que quer excluir a turma \"#{turma.tur_nome}\"?')",
            class: 'text-sm px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700' %>
      </div>
    </div>
  </div>
</div>