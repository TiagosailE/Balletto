<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold"><%= @turma.tur_nome %></h1>
    <div class="text-sm text-gray-500">Vagas: <strong><%= @turma.vagas_info %></strong></div>
  </div>

  <div class="bg-white border rounded-lg p-4 mb-6">
    <p><strong>Professor:</strong> <%= @turma.professor&.nome.presence || 'Não atribuído' %></p>
    <p><strong>Nível:</strong> <%= @turma.tur_nivel.presence || '—' %></p>
    <p class="text-sm text-gray-600 mt-1">
  <p>
  <strong>Horário:</strong>
  <% if @turma.tur_dia_da_semana.present? && @turma.tur_horario.present? %>
    <%= @turma.tur_dia_da_semana %>, <%= @turma.tur_horario.strftime('%H:%M') %>
  <% elsif @turma.tur_horario.present? %>
    <%= @turma.tur_horario.strftime('%H:%M') %>
  <% else %>
    —
  <% end %>
</p>
    <div class="mt-4">
      <%= link_to 'Editar', edit_turma_path(@turma), class: 'text-sm px-3 py-1 border rounded text-gray-700' %>
      <%= link_to 'Voltar', turmas_path, class: 'ml-2 text-sm text-gray-600' %>
    </div>
  </div>

  <section>
    <h2 class="text-lg font-medium mb-2">Alunos da turma</h2>

    <% if @alunos.present? && @alunos.any? %>
      <ul class="space-y-2">
        <% @alunos.each do |aluno| %>
          <li class="bg-white border rounded p-3">
            <%= aluno.try(:nome) || "Aluno ##{aluno.id}" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-gray-500">Nenhum aluno cadastrado nesta turma.</div>
    <% end %>
  </section>
</div>