<%# Wrapper principal e cabeçalho %>
<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <div class="text-center mb-6">
    <h1 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">
      <%# Altera o título dinamicamente se for novo/edição %>
      <%= user.persisted? ? "Editar Professor" : "Novo Professor" %>
    </h1>
    <p class="mt-3 max-w-xl mx-auto text-lg text-gray-500 dark:text-gray-400">
      Preencha os detalhes abaixo para <%= user.persisted? ? "atualizar o" : "cadastrar um novo" %> professor.
    </p>
  </div>

  <%# Card principal do formulário com modo claro/escuro %>
  <%= form_with(model: user, class: "bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-[#2E2E2E]") do |form| %>
    
    <%# Bloco de erros com modo claro/escuro %>
    <% if user.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900 dark:bg-opacity-50 text-red-700 dark:text-red-300 p-4 border-b border-red-200 dark:border-red-800">
        <h3 class="font-bold mb-2 text-red-800 dark:text-red-200"><%= pluralize(user.errors.count, "erro") %> impediu este professor de ser salvo:</h3>
        <ul class="list-disc list-inside text-sm">
          <% user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Padding interno e layout em grid %>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">

        <%# --- DADOS DO PROFESSOR --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 first:mt-0 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Dados de Acesso
        </h3>

        <div class="md:col-span-2">
          <%= form.label :nome, "Nome Completo", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = user.errors[:nome].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-user-tie w-5 text-center text-gray-400 dark:text-gray-500"></i> <!-- Ícone de Professor -->
            </div>
            <%= form.text_field :nome, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "Nome completo do professor" %>
          </div>
          <% if user.errors[:nome].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= user.errors.full_messages_for(:nome).first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :usuario, "Nome de Usuário", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = user.errors[:usuario].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-at w-5 text-center text-gray-400 dark:text-gray-500"></i> <!-- Ícone de Usuário -->
            </div>
            <%= form.text_field :usuario, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "ex: joao.silva" %>
          </div>
          <% if user.errors[:usuario].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= user.errors.full_messages_for(:usuario).first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :email, "Email", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = user.errors[:email].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-envelope w-5 text-center text-gray-400 dark:text-gray-500"></i> <!-- Ícone de Email -->
            </div>
            <%= form.email_field :email, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "email@exemplo.com" %>
          </div>
          <% if user.errors[:email].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= user.errors.full_messages_for(:email).first %></p>
          <% end %>
        </div>
        
        <div class="md:col-span-2">
          <%= form.label :password, "Senha", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = user.errors[:password].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-lock w-5 text-center text-gray-400 dark:text-gray-500"></i> <!-- Ícone de Senha -->
            </div>
            <%= form.password_field :password, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "••••••••" %>
          </div>
          
          <%# Dica para o campo de senha, crucial para 'edit' %>
          <% if user.persisted? %>
             <p class="text-gray-500 dark:text-gray-400 text-xs mt-1.5">Deixe em branco se não quiser alterar a senha.</p>
          <% end %>

          <% if user.errors[:password].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= user.errors.full_messages_for(:password).first %></p>
          <% end %>
        </div>
        
        <!-- NÃO incluímos o campo de foto, como solicitado -->

      </div>
    </div>

    <%# Botões de ação com modo claro/escuro %>
    <div class="bg-gray-50 dark:bg-[#111111] px-6 py-4 border-t border-gray-200 dark:border-[#2E2E2E] flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3">
      
      <%# Botão Cancelar (Estilo secundário) %>
      <%= link_to users_path, 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-600 dark:text-gray-300 font-bold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' do %>
        <span>Cancelar</span>
      <% end %>
      
      <%# Botão Salvar (Estilo de marca) %>
      <%= form.submit (user.persisted? ? 'Atualizar Professor' : 'Salvar Professor'), 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-100 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' 
      %>
    </div>

  <% end %>
</div>