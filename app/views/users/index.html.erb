<div class="w-full max-w-lg px-6 py-10 font-sans text-gray-800 dark:text-gray-300 rounded-lg mx-auto flex flex-col h-full">

  <div class="flex-shrink-0">
    <div class="p-1 bg-white dark:bg-[#1C1C1C] border border-gray-300 dark:border-[#2E2E2E] rounded-lg flex items-center justify-around">
      
      <a href="<%= users_path %>" class="flex-1 text-center px-5 py-2 font-bold bg-[#C5A300] text-black rounded-lg shadow-md">
        Professores
      </a>
      
      <a href="#" class="flex-1 text-center px-5 py-2 font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-300 dark:hover:bg-gray-700 dark:hover:text-white rounded-lg">
        Inativos
      </a>
    </div>

    <div class="mt-6">
      <%= form_with(url: users_path, method: :get, class: "relative") do |form| %>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <i class="fas fa-search text-gray-500 dark:text-gray-400"></i>
        </div>
        <%= form.text_field :query, 
              value: params[:query], 
              placeholder: "Buscar professor...",
              class: "w-full pl-10 pr-4 py-3 bg-white dark:bg-[#1C1C1C] text-gray-900 dark:text-white border border-gray-300 dark:border-[#2E2E2E] rounded-lg placeholder-gray-400 dark:placeholder-gray-500 focus:border-[#C5A300] focus:ring-1 focus:ring-[#C5A300] outline-none" %>
      <% end %>
    </div>

    <div class="mt-4">
      <%= link_to new_user_path, class: "flex items-center justify-center gap-2 w-full px-4 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Cadastrar Novo Professor</span>
      <% end %>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto mt-8">
    <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4">
      Professores
    </h2>

    <div id="professores-list" class="space-y-3 pr-2">
      <% if @users.empty? %>
        <p class="text-gray-500 text-center">Nenhum professor cadastrado ainda.</p>
      <% end %>

      <% @users.each do |user| %>
        <a href="<%= user_path(user) %>" class="flex items-center p-4 bg-white dark:bg-[#1C1C1C] rounded-xl shadow border border-gray-200 dark:border-[#2E2E2E] hover:bg-gray-100 dark:hover:bg-gray-800">
          
          <div class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-user-tie text-gray-500 dark:text-gray-400 text-xl"></i>
          </div>

          <div class="flex-1 ml-4 min-w-0">
            <div class="font-medium text-lg text-gray-900 dark:text-gray-200 truncate" title="<%= user.nome %>">
              <%= user.nome %>
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-500 truncate" title="<%= user.email %>">
              <%= user.email %>
            </div>
          </div>

          <div class="ml-2">
            <i class="fas fa-chevron-right text-gray-400 dark:text-gray-600"></i>
          </div>
        </a>
      <% end %>
    </div>
  </div>

</div>