<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="text-center mb-10">
    <h2 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">Gerenciar Professores</h2>
    <p class="mt-4 max-w-2xl mx-auto text-lg text-gray-400">
      Organize, crie e gerencie todos os professores em um só lugar.
    </p>
  </div>

  <div class="flex flex-col md:flex-row md:gap-8 items-start justify-center">
    <aside class="w-full md:w-auto mb-6 md:mb-0 flex justify-center md:block">
      <%= link_to new_user_path,
        class: "inline-flex justify-center items-center gap-2 px-6 py-3 bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Cadastrar Novo Professor</span>
      <% end %>
    </aside>
  </div>

  <div lass="flex-1 w-full">
    <div id="turmas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
      <% @users.each do |user| %>
        <div class="col-span-full bg-[#1C1C1C] rounded-2xl shadow p-8 text-center text-gray-400 border border-[#2E2E2E] m-4">
          <div>
            <p class="font-medium"><%= user.nome %></p>
            <p class="text-sm text-gray-600"><%= user.email %></p>
          </div>
          <div class="flex gap-2">
            <%= link_to 'Editar', edit_user_path(user), class: 'text-sm px-3 py-1 border rounded text-gray-700 hover:bg-gray-50' %>
            <%= button_to 'Excluir', user_path(user), method: :delete, data: { confirm: 'Tem certeza?' }, class: 'text-sm px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700' %>
          </div>
        </div>
      <% end %>

      <% if @users.empty? %>
        <p class="text-gray-500">Nenhum professor cadastrado ainda.</p>
      <% end %>
    </div>
  </div>
</div>