<div class="pb-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Criar Novo Usuário</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-1">Adicione um novo membro à equipe</p>
      </div>
      <%= link_to root_path, class: "px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-[#C5A300] dark:hover:text-[#D4AF37] transition-colors" do %>
        <i class="fas fa-arrow-left mr-2"></i>Voltar
      <% end %>
    </div>

    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-[#2E2E2E]">
      <%= render 'form', user: @user %>
    </div>

  </div>
</div>