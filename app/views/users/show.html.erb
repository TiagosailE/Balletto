<%# app/views/users/show.html.erb %>

<%# Wrapper principal e cabeçalho %>
<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <div class="text-center mb-6">
    
    <%# Placeholder (sem foto) %>
    <div class="w-32 h-32 rounded-full mx-auto mb-4 bg-gray-100 dark:bg-[#0A0A0A] border-4 border-gray-200 dark:border-[#2E2E2E] flex items-center justify-center shadow-lg">
      <i class="fas fa-user-tie fa-3x text-gray-400 dark:text-gray-500"></i>
    </div>

    <h1 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">
      <%= @user.nome %>
    </h1>
    <p class="mt-3 max-w-xl mx-auto text-lg text-gray-500 dark:text-gray-400">
      Detalhes do Professor
    </p>
  </div>

  <%# Card principal de conteúdo (com modo claro/escuro) %>
  <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-[#2E2E2E]">
    
    <%# Padding interno e layout em grid %>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
        
        <%# --- DADOS DE ACESSO --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 first:mt-0 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Dados de Acesso
        </h3>

        <div>
          <span class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1 flex items-center"><i class="fas fa-envelope w-5 text-center text-gray-500 mr-2"></i>Email</span>
          <p class="text-lg text-gray-900 dark:text-[#E5E5E5] break-words"><%= @user.email %></p>
        </div>

        <div>
          <span class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1 flex items-center"><i class="fas fa-at w-5 text-center text-gray-500 mr-2"></i>Usuário</span>
          <p class="text-lg text-gray-900 dark:text-[#E5E5E5]"><%= @user.usuario %></p>
        </div>

        <div class="md:col-span-2">
          <span class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1 flex items-center"><i class="fas fa-user-shield w-5 text-center text-gray-500 mr-2"></i>Tipo de Conta</span>
          <%# Badge (similar ao Status do aluno) %>
          <% if @user.admin? %>
            <p class="text-lg font-semibold px-3 py-1 rounded-full inline-block bg-blue-600 bg-opacity-30 text-blue-300">
              Administrador
            </p>
          <% else %>
            <p class="text-lg font-semibold px-3 py-1 rounded-full inline-block bg-gray-600 bg-opacity-30 text-gray-300">
              Professor
            </p>
          <% end %>
        </div>
        
        <!-- Outras seções (como 'Turmas Ministradas') podem ser adicionadas aqui no futuro -->

      </div>
    </div>

    <%# Botões de ação estilizados (padrão alunos/show) %>
    <div class="bg-gray-50 dark:bg-[#111111] px-6 py-4 border-t border-gray-200 dark:border-[#2E2E2E] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      
      <%# Botão Voltar (Alinhado à esquerda) %>
      <%= link_to users_path, 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-600 dark:text-gray-300 font-bold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' do %>
        <i class="fas fa-arrow-left"></i>
        <span>Voltar</span>
      <% end %>

      <%# Botões Editar e Excluir (Alinhados à direita) %>
      <div class="flex flex-col sm:flex-row gap-3">
        
        <%# Botão Editar (Estilo de marca) %>
        <%= link_to edit_user_path(@user), 
              class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-100 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' do %>
          <i class="fas fa-pencil-alt"></i>
          <span>Editar</span>
        <% end %>
        
        <%# Botão Excluir (Estilo de perigo - USANDO O MODAL) %>
        <button
          type="button"
          class="w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-red-600 text-white font-bold rounded-lg shadow-md border border-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-red-500 transition-all transform hover:scale-105 cursor-pointer"
          data-confirm-modal="true"
          data-confirm-title="Excluir Professor"
          data-confirm-body="Tem certeza que deseja excluir o professor '<%= @user.nome %>'?"
          data-confirm-path="<%= user_path(@user) %>"
          data-confirm-text="Excluir"
          data-confirm-class="bg-red-600 hover:bg-red-500">
          <i class="fas fa-trash-alt"></i>
          <span>Excluir</span>
        </button>
      </div>
    </div>
    
  </div>
</div>