<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <%# --- CABEÇALHO PADRONIZADO --- %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
        <div class="w-12 h-12 bg-gradient-to-br from-[#C5A300] to-[#B88B00] rounded-xl flex items-center justify-center shadow-lg shadow-yellow-500/20">
          <i class="fas fa-calendar-alt text-white text-xl"></i>
        </div>
        Gestão de Eventos
      </h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2 ml-15">
        <%= @eventos.count %> <%= @eventos.count == 1 ? 'evento programado' : 'eventos programados' %>
      </p>
    </div>

    <%= link_to new_evento_path, class: "group inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-[#C5A300] to-[#D4AF37] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200" do %>
      <i class="fas fa-plus group-hover:rotate-90 transition-transform duration-200"></i>
      <span class="hidden sm:inline">Criar Novo Evento</span>
      <span class="sm:hidden">Novo Evento</span>
    <% end %>
  </div>

  <%# --- CONTEÚDO PRINCIPAL --- %>

  <% if @eventos.empty? %>
    <%# --- EMPTY STATE --- %>
    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg border border-gray-200 dark:border-[#2E2E2E] p-12 text-center">
      <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-[#0F0F0F] dark:to-[#1A1A1A] rounded-full flex items-center justify-center">
        <i class="fas fa-calendar-times text-3xl text-gray-400 dark:text-gray-600"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
        Nenhum evento cadastrado
      </h3>
      <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">
        Comece criando um novo evento para gerenciar espetáculos e apresentações.
      </p>
      <%= link_to new_evento_path, class: "inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-[#C5A300] to-[#D4AF37] text-white font-semibold rounded-xl shadow-lg" do %>
        <i class="fas fa-plus"></i>
        <span>Criar Primeiro Evento</span>
      <% end %>
    </div>

  <% else %>
    <%# --- GRID DE EVENTOS --- %>
    <div id="eventos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <% @eventos.each do |evento| %>
        <div 
          class="group bg-white dark:bg-[#1C1C1C] rounded-xl shadow-lg border border-gray-200 dark:border-[#2E2E2E] hover:shadow-xl hover:scale-[1.02] transition-all duration-200 flex flex-col h-full cursor-pointer relative overflow-hidden"
          data-evento-id="<%= evento.EVE_CODIGO %>"
          onclick="abrirModalTurmas(<%= evento.EVE_CODIGO %>)"
        >
          
          <div class="p-6 flex-grow flex flex-col">
            
            <%# Topo do Card: Data e Horário %>
            <div class="flex items-start justify-between mb-4">
              <%# Badge de Data Estilizado %>
              <div class="flex-shrink-0 flex flex-col items-center justify-center w-16 h-16 rounded-xl bg-gradient-to-br from-[#C5A300] to-[#B88B00] text-white shadow-lg shadow-yellow-500/20 border border-[#D4AF37]">
                <% if evento.EVE_DATA.present? %>
                  <span class="text-[10px] font-bold uppercase tracking-wider bg-black/10 w-full text-center py-0.5 rounded-t-xl">
                    <%= evento.EVE_DATA.strftime("%b") %>
                  </span>
                  <span class="text-2xl font-extrabold leading-none pt-1 pb-1">
                    <%= evento.EVE_DATA.strftime("%d") %>
                  </span>
                <% else %>
                  <i class="fas fa-calendar text-2xl opacity-80"></i>
                <% end %>
              </div>

              <%# Horário %>
              <% if evento.EVE_DATA.present? %>
                <div class="flex items-center gap-1.5 px-3 py-1 bg-gray-50 dark:bg-[#111111] rounded-lg border border-gray-100 dark:border-[#2E2E2E]">
                  <i class="fas fa-clock text-xs text-[#C5A300]"></i>
                  <span class="text-sm font-bold text-gray-700 dark:text-gray-300">
                    <%= evento.EVE_DATA.strftime("%H:%M") %>
                  </span>
                </div>
              <% end %>
            </div>

            <%# Informações Principais %>
            <div class="mb-2">
              <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-[#C5A300] transition-colors leading-tight mb-3">
                <%= evento.EVE_NOME %>
              </h3>

              <div class="space-y-2.5">
                <%# Local %>
                <div class="flex items-start text-sm text-gray-600 dark:text-gray-400">
                  <div class="w-6 flex-shrink-0 pt-0.5">
                    <i class="fas fa-map-marker-alt text-[#C5A300]"></i>
                  </div>
                  <span class="line-clamp-1"><%= evento.EVE_LOCAL.presence || 'Local não informado' %></span>
                </div>

                <%# Descrição %>
                <div class="flex items-start text-sm text-gray-500 dark:text-gray-500">
                  <div class="w-6 flex-shrink-0 pt-0.5">
                    <i class="fas fa-align-left text-gray-400"></i>
                  </div>
                  <p class="line-clamp-2"><%= evento.EVE_DESC.presence || 'Sem descrição.' %></p>
                </div>
              </div>
            </div>

          </div>

          <%# Rodapé do Card %>
          <div class="bg-gray-50 dark:bg-[#111111] px-5 py-3 border-t border-gray-200 dark:border-[#2E2E2E] flex items-center justify-between mt-auto">
            
            <div class="flex items-center gap-2">
              <i class="fas fa-layer-group text-gray-400 dark:text-gray-500"></i>
              <span class="text-sm font-bold text-gray-900 dark:text-white">
                <%= evento.turmas.count %> <span class="text-gray-400 text-xs font-normal">turmas</span>
              </span>
            </div>

            <div class="flex items-center gap-3">
              <%= link_to edit_evento_path(evento),
                  class: "text-gray-500 hover:text-[#C5A300] dark:text-gray-400 dark:hover:text-[#C5A300] transition-colors p-1",
                  title: "Editar Evento",
                  data: { turbo: false },
                  onclick: "event.stopPropagation()" do %>
                <i class="fas fa-pencil-alt"></i>
              <% end %>

              <button 
                type="button"
                class="text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-500 transition-colors p-1"
                title="Excluir Evento"
                data-confirm-modal="true"
                data-confirm-title="Excluir Evento"
                data-confirm-body="Tem certeza que deseja excluir o evento '<%= evento.EVE_NOME %>'? Esta ação não pode ser desfeita."
                data-confirm-path="<%= evento_path(evento) %>"
                data-confirm-text="Excluir"
                data-confirm-class="bg-red-600 hover:bg-red-500"
                onclick="event.stopPropagation()">
                <i class="fas fa-trash-alt"></i>
              </button>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= render 'modal_turmas_evento' %>