<div class="w-full max-w-screen-2xl mx-auto">
  <div class="text-center mb-10">
    <h2 class="text-4xl font-extrabold text-[#B88B00] sm:text-5xl transition-colors duration-200">
      Gestão de Eventos
    </h2>
    <p class="mt-4 max-w-2xl mx-auto text-lg text-[#6B747A] dark:text-gray-400 transition-colors duration-200">
      Crie, edite e acompanhe todos os eventos e espetáculos da escola.
    </p>
  </div>

  <div class="flex flex-col md:flex-row md:gap-8 items-start justify-center">
    <aside class="w-full md:w-auto mb-6 md:mb-0 flex justify-center md:block">
      <%= link_to new_evento_path,
        class: "inline-flex justify-center items-center gap-2 px-6 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Criar Novo Evento</span>
      <% end %>
    </aside>

    <div class="flex-1 w-full">
      <div id="eventos-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
        <% if @eventos.blank? %>
          <div class="col-span-full bg-[#1C1C1C] rounded-2xl shadow p-8 text-center text-gray-400 border border-[#2E2E2E]">
            <i class="fas fa-calendar-alt text-4xl mb-4 text-gray-500"></i>
            <h3 class="text-lg font-semibold text-[#E5E5E5]">Nenhum evento cadastrado</h3>
            <p class="mt-1">Clique em "Criar Novo Evento" para adicionar um.</p>
          </div>
        <% else %>
          <% @eventos.each do |evento| %>
            <div 
  class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg overflow-hidden transform hover:-translate-y-1 transition-transform duration-300 ease-in-out border border-gray-200 dark:border-[#2E2E2E] flex flex-col w-full h-full hover:border-[#C5A300] cursor-pointer"
  data-evento-id="<%= evento.EVE_CODIGO %>"
  onclick="abrirModalTurmas(<%= evento.EVE_CODIGO %>)"
>

              <div class="p-5 flex-grow">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-bold text-[#2A2F33] dark:text-[#E5E5E5]">
                    <%= evento.EVE_NOME %>
                  </h3>
                  <span class="border border-yellow-300 px-2 py-0.5 text-xs font-medium text-yellow-800 bg-yellow-100 rounded-full whitespace-nowrap">
                    <%= evento.EVE_DATA.strftime("%d/%m/%Y") if evento.EVE_DATA.present? %>
                  </span>
                </div>

                <div class="space-y-3 text-sm text-[#6B747A] dark:text-gray-400">
                  <div class="flex items-center">
                    <i class="fas fa-map-marker-alt w-5 text-center text-[#8A939E] dark:text-gray-500 mr-3"></i>
                    <span><%= evento.EVE_LOCAL %></span>
                  </div>
                  <div class="flex items-start">
                    <i class="fas fa-align-left w-5 text-center text-[#8A939E] dark:text-gray-500 mr-3 mt-0.5"></i>
                    <p class="line-clamp-2"><%= evento.EVE_DESC %></p>
                  </div>
                </div>
              </div>
              
              <div class="bg-gray-50 dark:bg-[#111111] px-5 py-3 border-t border-gray-200 dark:border-[#2E2E2E] flex items-center justify-between text-sm">
                <div class="flex items-center gap-2 text-[#6B747A] dark:text-gray-400">
                  <i class="fas fa-layer-group text-[#B88B00]"></i>
                  <span class="font-semibold text-[#2A2F33] dark:text-[#E5E5E5]">
                    <%= evento.turmas.count %>
                  </span>
                  <span class="text-[#6B747A] dark:text-gray-500">turmas</span>
                </div>

                <div class="flex items-center gap-4">
                  <%= link_to "Editar", edit_evento_path(evento),
                        class: "font-semibold text-[#B88B00] hover:text-[#D4AA00] transition-colors", 
                        data: { turbo: false },
                        onclick: "event.stopPropagation()" %>
                  <button 
                    type="button"
                    class="text-[#6B747A] hover:text-[#CC4444] transition-colors"
                    title="Excluir Evento"
                    data-confirm-modal="true"
                    data-confirm-title="Excluir Evento"
                    data-confirm-body="Tem certeza que deseja excluir o evento '<%= evento.EVE_NOME %>'?"
                    data-confirm-path="<%= evento_path(evento) %>"
                    data-confirm-text="Excluir"
                    data-confirm-class="bg-red-600 hover:bg-red-500"
                    onclick="event.stopPropagation()">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render 'modal_turmas_evento' %>
