<!-- Modal de Turmas -->
<div id="modal-turmas-evento" 
     class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-[9999]">

  <div id="modal-content"
       class="bg-white dark:bg-[#1C1C1C] rounded-xl w-full max-w-4xl mx-4 
              border border-gray-200 dark:border-[#2E2E2E]
              overflow-hidden transform transition-transform duration-200 scale-95 opacity-0">

    <!-- Header -->
    <div class="flex justify-between items-center px-6 py-4 bg-[#C5A300]">
      <h3 class="text-2xl font-bold text-black flex items-center gap-2">
        <i class="fas fa-users"></i> Turmas do Evento
      </h3>
      <button onclick="window.fecharModalTurmas()" 
              class="text-black hover:text-red-600 transition-colors text-xl">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <!-- Conteúdo -->
    <div id="turmas-list" class="p-6 max-h-[70vh] overflow-y-auto">
      <div class="text-center text-gray-400 py-8">
        <i class="fas fa-spinner fa-spin text-2xl"></i>
        <p class="mt-2">Carregando turmas...</p>
      </div>
    </div>

    <!-- Footer -->
    <div class="border-t border-gray-200 dark:border-[#2E2E2E] px-6 py-4 
                bg-gray-50 dark:bg-[#111111] flex justify-end">

      <button onclick="window.fecharModalTurmas()" 
              class="px-6 py-2 rounded-lg bg-gray-200 dark:bg-[#222] 
                     text-gray-700 dark:text-gray-300 
                     hover:bg-gray-300 dark:hover:bg-[#333]
                     transition-colors font-medium">
        Fechar
      </button>
    </div>
  </div>
</div>

<!-- Modal de Alunos -->
<div id="modal-alunos-evento" 
     class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-[99999]">

  <div id="modal-alunos-content"
       class="bg-white dark:bg-[#1C1C1C] rounded-xl w-full max-w-2xl mx-4
              border border-gray-200 dark:border-[#2E2E2E]
              overflow-hidden transform transition-transform duration-200 scale-95 opacity-0">

    <!-- Header -->
    <div class="px-6 py-4 bg-[#C5A300]">
      <div class="flex justify-between items-start">
        <div>
          <h3 class="text-2xl font-bold text-black flex items-center gap-2">
            <i class="fas fa-user-friends"></i>
            Alunos Participantes
          </h3>
          <p id="turma-nome-header" class="text-sm text-black/80 mt-1 font-medium"></p>
        </div>
        <button onclick="window.fecharModalAlunosEvento()" 
                class="text-black hover:text-red-600 transition-colors text-xl">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>

    <!-- Lista de alunos -->
    <div id="alunos-list" class="p-6 space-y-3 max-h-[60vh] overflow-y-auto">
      <div class="text-center text-gray-400 py-8">
        <i class="fas fa-spinner fa-spin text-2xl"></i>
      </div>
    </div>

    <!-- Footer -->
    <div class="border-t border-gray-200 dark:border-[#2E2E2E] px-6 py-4 
                bg-gray-50 dark:bg-[#111111] flex justify-between items-center">

      <div class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-400">
        <i class="fas fa-check-circle text-[#C5A300]"></i>
        <span id="alunos-confirmados-count" class="font-medium">0 alunos confirmados</span>
      </div>

      <button onclick="window.fecharModalAlunosEvento()" 
              class="px-6 py-2 rounded-lg bg-[#C5A300] hover:bg-[#D4AA00]
                     text-black font-bold transition-transform duration-150 hover:scale-[1.03]">
        Concluir
      </button>
    </div>
  </div>
</div>

<style>
  /* Checkbox muito mais leve */
  .custom-checkbox {
    appearance: none;
    width: 22px;
    height: 22px;
    border: 2px solid #C5A300;
    border-radius: 5px;
    cursor: pointer;
    position: relative;
    transition: border-color .2s, background-color .2s;
  }
  .custom-checkbox:hover {
    border-color: #D4AA00;
  }
  .custom-checkbox:checked {
    background-color: #C5A300;
  }
  .custom-checkbox:checked::after {
    content: '✔';
    position: absolute;
    inset: 0;
    display:flex;
    align-items:center;
    justify-content:center;
    color:white;
    font-size: 14px;
  }

  /* Cards muito mais leves */
  .turma-card {
    border: 1px solid #dcdcdc;
    border-radius: 10px;
    padding: 16px;
    background-color: #fafafa;
    cursor: pointer;

    /* transição optimizada (nada de transition-all) */
    transition: transform .15s ease, border-color .15s ease;
  }

  .dark .turma-card {
    background-color: #111111;
    border-color: #2E2E2E;
  }

  .turma-card:hover {
    transform: translateY(-3px);
    border-color: #C5A300;
  }
</style>
