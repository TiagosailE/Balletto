<% content_for :title, "Editar Evento" %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold text-center text-[#B88B00] mb-6">
    Editar Evento
  </h1>

  <%= form_with(model: @evento, class: "bg-white dark:bg-black rounded-lg shadow-md overflow-hidden") do |form| %>
    <%= render "form", form: form %>
  <% end %>
</div>