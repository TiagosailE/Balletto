<div class="w-full max-w-5xl px-6 py-10 font-sans text-gray-800 dark:text-gray-300 rounded-lg mx-auto flex flex-col h-full">

  <header class="flex justify-between items-center px-4 sm:px-6 py-4">
    <h1 class="text-2xl font-bold text-[#C5A300]">
      Olá, <%= current_user.nome %>!
    </h1>
    
    <%= link_to "Sair", destroy_user_session_path,
        data: { "turbo-method": :delete },
        class: "px-4 py-2 bg-white dark:bg-black text-[#C5A300] font-semibold rounded-lg border border-[#C5A300]
                hover:bg-gray-50 dark:hover:bg-[#1C1C1C] hover:text-[#D4AF37] transition-all duration-200" %>
  </header>

  <main class="flex-1 container mx-auto px-4 sm:px-6 py-8 pb-24">

    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-600 dark:text-gray-400 mb-4">Próximos Eventos</h2>
      
      <div class="flex flex-col gap-4">
        <% if @eventos.blank? %>
          <div class="col-span-full bg-white dark:bg-[#1C1C1C] rounded-2xl shadow p-6 text-center text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-[#2E2E2E]">
            <i class="fas fa-calendar-alt text-3xl mb-3 text-gray-400 dark:text-gray-500"></i>
            <h3 class="text-md font-semibold text-gray-700 dark:text-[#E5E5E5]">Nenhum próximo evento cadastrado.</h3>
            <%= link_to "Criar um evento", new_evento_path, class: "text-sm font-medium text-[#C5A300] hover:text-[#D4AF37] mt-1" %>
          </div>
        <% else %>
          <% @eventos.each do |evento| %>
            <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg overflow-hidden border border-gray-200 dark:border-[#2E2E2E] flex flex-col w-full transition-all duration-200 hover:shadow-md">
              
              <div class="p-4 flex gap-4 items-start">          
                <div class="flex-shrink-0 flex flex-col items-center justify-center w-16 h-16 rounded-lg bg-[#B88B00] shadow-md">
                  <% if evento.EVE_DATA.present? %>
                    <span class="text-xs font-bold uppercase text-[#F0D04A]">
                      <%= evento.EVE_DATA.strftime("%b") %>
                    </span>
                    <span class="text-2xl font-extrabold text-white tracking-tight">
                      <%= evento.EVE_DATA.strftime("%d") %>
                    </span>
                  <% else %>
                    <i class="fas fa-calendar-times text-2xl text-white/50"></i>
                  <% end %>
                </div>
                
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold text-[#2A2F33] dark:text-[#E5E5E5] leading-tight truncate">
                    <%= evento.EVE_NOME %>
                  </h3>
                  
                  <div class="mt-1 space-y-1 text-sm text-[#6B747A] dark:text-gray-400">
                    <div class="flex items-start">
                      <i class="fas fa-map-marker-alt w-4 text-center text-[#B88B00] dark:text-[#C5A300] mr-2 flex-shrink-0 pt-0.5"></i>
                      <span class="dark:text-gray-300 truncate"><%= evento.EVE_LOCAL %></span>
                    </div>
                    <div class="flex items-start">
                      <i class="fas fa-align-left w-4 text-center text-[#B88B00] dark:text-[#C5A300] mr-2 flex-shrink-0 pt-0.5"></i>
                      <p class="dark:text-gray-300 truncate"><%= evento.EVE_DESC.presence || "Sem descrição." %></p>
                    </div>
                  </div>
                </div>

                <% if evento.EVE_DATA.present? %>
                  <div class="text-right flex-shrink-0 ml-2">
                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">HORÁRIO</span>
                    <span class="block text-xl font-bold text-[#C5A300] dark:text-[#C5A300]">
                      <%= evento.EVE_DATA.strftime("%H:%M") %>
                    </span>
                  </div>
                <% end %>
              </div>

              <div class="bg-gray-50 dark:bg-[#111111] px-4 py-2 border-t border-gray-200 dark:border-[#2E2E2E] flex items-center justify-between text-sm">
                <div class="flex items-center gap-2 text-gray-800 dark:text-[#E5E5E5]">
                  <i class="fas fa-layer-group text-[#B88B00]"></i>
                  <span class="font-semibold">
                    <%= pluralize(evento.turmas.count, "turma", "turmas") %>
                  </span>
                </div>

                <div class="flex items-center gap-4">
                  <%= link_to "Editar", edit_evento_path(evento),
                        class: "bg-[#C5A300] hover:bg-[#D4AA00] text-white font-bold py-1 px-3 rounded-md transition-colors text-xs",
                        data: { turbo: false } %>
                  
                  <button
                    type="button"
                    class="text-[#6B747A] hover:text-[#CC4444] dark:hover:text-[#E57373] transition-colors"
                    title="Excluir Evento"
                    data-confirm-modal="true"
                    data-confirm-title="Excluir Evento"
                    data-confirm-body="Tem certeza que deseja excluir o evento '<%= evento.EVE_NOME %>'?"
                    data-confirm-path="<%= evento_path(evento) %>"
                    data-confirm-text="Excluir"
                    data-confirm-class="bg-red-600 hover:bg-red-500">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if @eventos.present? %>
        <div class="text-center mt-6">
          <%= link_to "Ver todos os eventos", eventos_path, 
                class: "text-lg font-semibold text-gray-600 dark:text-gray-400 mb-4 hover:text-[#C5A300]" %>
        </div>
      <% end %>
    </section>

    <section>
      <h1 class="text-lg font-semibold text-gray-600 dark:text-gray-400 mb-4">Acessos Rápidos</h1>
      
      <div class="flex flex-col gap-4">
        
        <%= link_to alunos_path,
              class: "flex items-center justify-center gap-2 w-full px-4 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
          <i class="fas fa-user-plus text-[#C5A300] text-xl w-6 text-center"></i>
          <span>Cadastrar Aluno</span>
        <% end %>

        <%= link_to users_path,
              class: "flex items-center justify-center gap-2 w-full px-4 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
          <i class="fas fa-layer-group text-[#C5A300] text-xl w-6 text-center"></i>
          <span>Gerenciar Professores</span>
        <% end %>

        <%= link_to "#",
              class: "flex items-center justify-center gap-2 w-full px-4 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
          <i class="fas fa-bell text-[#C5A300] text-xl w-6 text-center"></i>
          <span>Notificações</span>
        <% end %>
      </div>
    </section>
  </main>
  

</div>