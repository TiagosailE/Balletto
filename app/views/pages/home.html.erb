<div class="min-h-screen bg-[#121212] text-gray-300 flex flex-col">

  <!-- 🔹 Cabeçalho -->
  <header class="flex justify-between items-center px-6 py-4 bg-[#1A1A1A] border-b border-[#2E2E2E] shadow-md">
    <h1 class="text-2xl font-bold text-[#C5A300]">
      Olá, <%= current_user.nome %>
    </h1>

    <%= link_to "Sair", destroy_user_session_path,
        data: { "turbo-method": :delete },
        class: "px-4 py-2 bg-black text-[#C5A300] font-semibold rounded-lg border border-[#C5A300]
                hover:bg-[#1C1C1C] hover:text-[#D4AF37] transition-all duration-200" %>
  </header>

  <!-- 🔹 Conteúdo Principal -->
  <main class="flex-1 container mx-auto px-6 py-10">
    <!-- Card de Info -->
    <section class="text-center mb-10">
      <p class="text-gray-400 text-lg">Total de alunos matriculados</p>
      <h2 class="text-5xl font-extrabold text-[#C5A300] mt-2"><%= @total_alunos %></h2>
    </section>

    <!-- Acesso Rápido -->
    <section class="text-center">
      <p class="text-gray-400 mb-4 text-lg font-medium">Acesso rápido</p>

      <div class="flex flex-wrap justify-center gap-4">
        <%= link_to "Cadastrar Alunos", alunos_path,
          class: "inline-flex items-center justify-center px-6 py-3 bg-black text-[#C5A300] font-bold
                   rounded-lg shadow-md border border-[#C5A300]
                   hover:bg-[#1A1A1A] hover:text-[#D4AF37]
                   focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300]
                   transition-all transform hover:scale-105" %>

        <% if current_user&.admin? %>
          <%= link_to 'Professores', users_path,
            class: "inline-flex items-center justify-center px-6 py-3 bg-black text-[#C5A300] font-bold
                   rounded-lg shadow-md border border-[#C5A300]
                   hover:bg-[#1A1A1A] hover:text-[#D4AF37]
                   focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300]
                   transition-all transform hover:scale-105" %>
        <% end %>
      </div>
    </section>
  </main>
</div>
