<div class="w-full max-w-lg px-6 py-10 font-sans text-gray-800 dark:text-gray-300 rounded-lg mx-auto flex flex-col h-full">

  <div class="shrink-0">
    <!-- Abas de Navegação -->
    <div class="p-1 bg-white dark:bg-[#1C1C1C] border border-gray-300 dark:border-[#2E2E2E] rounded-lg flex items-center justify-around">
      <!-- Aba Ativa (Estilo "marca" - pode ser o mesmo em ambos os modos) -->
      <a href="<%= alunos_path %>" class="flex-1 text-center px-5 py-2 font-bold bg-[#C5A300] text-black rounded-lg shadow-md">
        Alunos Matriculados
      </a>
      <!-- Aba Inativa -->
      <a href="#" class="flex-1 text-center px-5 py-2 font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-300 dark:hover:bg-gray-700 dark:hover:text-white rounded-lg">
        Possíveis Alunos
      </a>
    </div>

    <!-- Barra de Busca -->
    <div class="mt-6">
      <%= form_with(url: alunos_path, method: :get, class: "relative") do |form| %>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <i class="fas fa-search text-gray-500 dark:text-gray-400"></i>
        </div>
        <%= form.text_field :query, 
                value: params[:query], 
                placeholder: "Buscar aluno...",
                class: "w-full pl-10 pr-4 py-3 bg-white dark:bg-[#1C1C1C] text-gray-900 dark:text-white border border-gray-300 dark:border-[#2E2E2E] rounded-lg placeholder-gray-400 dark:placeholder-gray-500 focus:border-[#C5A300] focus:ring-1 focus:ring-[#C5A300] outline-none" %>
      <% end %>
    </div>

    <!-- Botão Adicionar Novo Aluno (Estilo "marca") -->
    <div class="mt-4">
      <%= link_to new_aluno_path, class: "flex items-center justify-center gap-2 w-full px-4 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Adicionar Novo Aluno</span>
      <% end %>
    </div>
  </div>

  <!-- Lista de Alunos -->
  <div class="flex-1 overflow-y-auto mt-8">
    <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4">
      Alunos Matriculados
    </h2>

    <div id="alunos-list" class="space-y-3 pr-2">
      <% if @alunos.empty? %>
        <p class="text-gray-500 text-center">Nenhum aluno cadastrado ainda.</p>
      <% end %>

      <% @alunos.each do |aluno| %>
        <!-- Card do Aluno -->
        <a href="<%= aluno_path(aluno) %>" class="flex items-center p-4 bg-white dark:bg-[#1C1C1C] rounded-xl shadow border border-gray-200 dark:border-[#2E2E2E] hover:bg-gray-100 dark:hover:bg-gray-800">
          
          <% if aluno.foto.attached? %>
            <%= image_tag aluno.foto.variant(resize_to_fill: [48, 48]), class: "w-12 h-12 rounded-full object-cover" %>
          <% else %>
            <!-- Placeholder da Foto -->
            <div class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
              <i class="fas fa-user text-gray-500 dark:text-gray-400"></i>
            </div>
          <% end %>

          <div class="flex-1 ml-4">
            <div class="font-medium text-lg text-gray-900 dark:text-gray-200"><%= aluno.alu_nome %></div>
            <div class="text-sm text-gray-600 dark:text-gray-500">Turma: <%= aluno.turma&.tur_nome || 'Sem turma' %></div>
          </div>

          <div>
            <i class="fas fa-chevron-right text-gray-400 dark:text-gray-600"></i>
          </div>
        </a>
      <% end %>
    </div>
  </div>

</div>