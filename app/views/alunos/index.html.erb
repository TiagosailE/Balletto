<div class="w-full max-w-lg px-6 py-10 font-sans text-gray-300 rounded-lg absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">

  <div class="p-1 bg-[#1C1C1C] border border-[#2E2E2E] rounded-lg flex items-center justify-around">
    <a href="<%= alunos_path %>" class="flex-1 text-center px-5 py-2 font-bold bg-[#C5A300] text-black rounded-lg shadow-md">
      Alunos Matriculados
    </a>
    <a href="#" class="flex-1 text-center px-5 py-2 font-medium text-gray-400 hover:bg-gray-700 hover:text-white rounded-lg">
      Possíveis Alunos
    </a>
  </div>

  <div class="mt-6">
    <%= form_with(url: alunos_path, method: :get, class: "relative") do |form| %>
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <i class="fas fa-search text-gray-400"></i>
      </div>
      <%= form.text_field :query, 
              value: params[:query], 
              placeholder: "Buscar aluno...",
              class: "w-full pl-10 pr-4 py-3 bg-[#1C1C1C] text-white border border-[#2E2E2E] rounded-lg placeholder-gray-500" %>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to new_aluno_path, class: "flex items-center justify-center gap-2 w-full px-4 py-3 bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-[#1A1A1A] hover:text-[#D4AF37] transition-all transform hover:scale-105" do %>
      <i class="fas fa-plus"></i>
      <span>Adicionar Novo Aluno</span>
    <% end %>
  </div>

  <h2 class="text-xl font-semibold text-gray-200 mt-8 mb-4">
    Alunos Matriculados
  </h2>

  <div id="alunos-list" class="space-y-3">
    <% if @alunos.empty? %>
      <p class="text-gray-500 text-center">Nenhum aluno cadastrado ainda.</p>
    <% end %>

    <% @alunos.each do |aluno| %>
      <%= link_to aluno_path(aluno), class: "flex items-center p-4 bg-[#1C1C1C] rounded-xl shadow border border-[#2E2E2E] hover:bg-gray-800" do %>
        
        <% if aluno.foto.attached? %>
          <%= image_tag aluno.foto.variant(resize_to_fill: [48, 48]), class: "w-12 h-12 rounded-full object-cover" %>
        <% else %>
          <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center">
            <i class="fas fa-user text-gray-400"></i>
          </div>
        <% end %>

        <div class="flex-1 ml-4">
          <div class="font-medium text-lg text-gray-200"><%= aluno.alu_nome %></div>
          <div class="text-sm text-gray-500">Turma: <%= aluno.turma&.tur_nome || 'Sem turma' %></div>
        </div>

        <div>
          <i class="fas fa-chevron-right text-gray-600"></i>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

