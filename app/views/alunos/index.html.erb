<div class="w-full max-w-screen-2xl mx-auto">
  <div class="text-center mb-10">
    <h2 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl transition-colors duration-200">Gerenciar Alunos</h2>
    <p class="mt-4 max-w-2xl mx-auto text-lg text-gray-600 dark:text-gray-400 transition-colors duration-200">
      Organize, crie e gerencie todos os alunos em um só lugar.
    </p>
  </div>

  <div class="flex flex-col md:flex-row md:gap-8 items-start justify-center">
    <aside class="w-full md:w-auto mb-6 md:mb-0 flex justify-center md:block">
      <%= link_to new_aluno_path,
        class: "inline-flex justify-center items-center gap-2 px-6 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
        <i class="fas fa-plus"></i>
        <span>Cadastrar Novo Aluno</span>
      <% end %>
    </aside>
  </div>

  <div class="flex-1 w-full">
    <div id="turmas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
      <% @alunos.each do |aluno| %>
        <div class="col-span-full bg-white dark:bg-[#1C1C1C] rounded-2xl shadow p-8 text-center text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-[#2E2E2E] m-4">
          <%= link_to aluno.alu_nome, aluno_path(aluno), class: "font-medium text-lg hover:underline" %>
          <p class="text-sm text-gray-600 dark:text-gray-400">Turma: <%= aluno.turma&.tur_nome || 'Sem turma' %></p>
          <p class="text-sm text-gray-600 dark:text-gray-400">Responsável: <%= aluno.responsavel_nome || 'Não informado' %></p>
        </div>
      <% end %>
      <% if @alunos.empty? %>
        <p class="text-gray-500">Nenhum aluno cadastrado ainda.</p>
      <% end %>
    </div>
  </div>
</div>