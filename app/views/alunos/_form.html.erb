<%= form_with(model: aluno, class: "space-y-4") do |form| %>
  <% if aluno.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(aluno.errors.count, "error") %> prohibited this aluno from being saved:</h2>
      <ul>
        <% aluno.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="border rounded-md p-3">
    <legend class="font-medium px-1">Dados do Aluno</legend>
    <div class="space-y-3">
      <div>
        <%= form.label :alu_nome, "Nome Completo", class: 'block font-medium' %>
        <%= form.text_field :alu_nome, class: 'w-full border rounded-md p-2' %>
      </div>
      <div>
        <%= form.label :alu_data_nascimento, "Data de Nascimento", class: 'block font-medium' %>
        <%= form.date_field :alu_data_nascimento, class: 'w-full border rounded-md p-2' %>
      </div>
      <div>
        <%= form.label :alu_endereco, "Endereço", class: 'block font-medium' %>
        <%= form.text_area :alu_endereco, rows: 3, class: 'w-full border rounded-md p-2' %>
      </div>
    </div>
  </fieldset>

  <fieldset class="border rounded-md p-3">
    <legend class="font-medium px-1">Dados do Responsável</legend>
    <div class="space-y-3">
      <div>
        <%= form.label :responsavel_nome, "Nome do Responsável", class: 'block font-medium' %>
        <%= form.text_field :responsavel_nome, class: 'w-full border rounded-md p-2' %>
      </div>
      <div>
        <%= form.label :responsavel_telefone, "Telefone do Responsável", class: 'block font-medium' %>
        <%= form.text_field :responsavel_telefone, class: 'w-full border rounded-md p-2' %>
      </div>
      <div>
        <%= form.label :responsavel_email, "Email do Responsável", class: 'block font-medium' %>
        <%= form.email_field :responsavel_email, class: 'w-full border rounded-md p-2' %>
      </div>
    </div>
  </fieldset>

  <fieldset class="border rounded-md p-3">
    <legend class="font-medium px-1">Matrícula e Saúde</legend>
    <div class="space-y-3">
      <div>
        <%= form.label :alu_tur_codigo, "Turma", class: 'block font-medium' %>
        <%= form.collection_select :alu_tur_codigo, @turmas, :tur_codigo, :tur_nome,
              { include_blank: 'Selecione uma turma (Opcional)' },
              { class: 'w-full border rounded-md p-2' } %>
      </div>
      <div>
        <%= form.label :alu_data_cadastro, "Data da Matrícula", class: 'block font-medium' %>
        <%= form.date_field :alu_data_cadastro, value: (aluno.alu_data_cadastro || Date.today), class: 'w-full border rounded-md p-2' %>
      </div>
      <div>
        <%= form.label :alu_status, "Status", class: 'block font-medium' %>
        <%= form.select :alu_status, ['Ativo', 'Inativo', 'Pendente'], { selected: 'Ativo' }, class: 'w-full border rounded-md p-2' %>
      </div>
      <div>
        <%= form.label :condicoes_medicas, "Condições Médicas (Descrição)", class: 'block font-medium' %>
        <%= form.text_area :condicoes_medicas, rows: 3, class: 'w-full border rounded-md p-2', placeholder: 'Ex: Asma, alergia a lactose...' %>
      </div>
    </div>
  </fieldset>

  <div class="actions">
    <%= form.submit "Salvar Aluno", class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 cursor-pointer' %>
    <%= link_to "Voltar", alunos_path,
      class: 'bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600 inline-block text-center' %>
  </div>
  
<% end %>