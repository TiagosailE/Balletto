<%# Wrapper principal e cabeçalho %>
<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <div class="text-center mb-6">
    <h1 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">
      <%# Altera o título dinamicamente se for um novo aluno ou edição %>
      <%= aluno.persisted? ? "Editar Aluno" : "Novo Aluno" %>
    </h1>
    <p class="mt-3 max-w-xl mx-auto text-lg text-gray-500 dark:text-gray-400">
      Preencha os detalhes abaixo para <%= aluno.persisted? ? "atualizar o" : "cadastrar um novo" %> aluno.
    </p>
  </div>

  <%# Card principal do formulário com modo claro/escuro %>
  <%= form_with(model: aluno, class: "bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-[#2E2E2E]") do |form| %>
    
    <%# Bloco de erros com modo claro/escuro %>
    <% if aluno.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900 dark:bg-opacity-50 text-red-700 dark:text-red-300 p-4 border-b border-red-200 dark:border-red-800">
        <h3 class="font-bold mb-2 text-red-800 dark:text-red-200"><%= pluralize(aluno.errors.count, "erro") %> impediu este aluno de ser salvo:</h3>
        <ul class="list-disc list-inside text-sm">
          <% aluno.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Padding interno e layout em grid %>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">

        <%# --- DADOS DO ALUNO --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 first:mt-0 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Dados do Aluno
        </h3>

        <div class="md:col-span-2">
          <%= form.label :alu_nome, "Nome Completo", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:alu_nome].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-user w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.text_field :alu_nome, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "Nome completo do aluno" %>
          </div>
          <% if aluno.errors[:alu_nome].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:alu_nome).first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :alu_data_nascimento, "Data de Nascimento", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:alu_data_nascimento].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-calendar-alt w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.date_field :alu_data_nascimento, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0 [color-scheme:light] dark:[color-scheme:dark]" %>
          </div>
          <% if aluno.errors[:alu_data_nascimento].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:alu_data_nascimento).first %></p>
          <% end %>
        </div>

        <div class="md:col-span-2">
          <%= form.label :alu_endereco, "Endereço", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:alu_endereco].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-start bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 pt-3.5 flex items-center pointer-events-none">
              <i class="fas fa-map-marker-alt w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.text_area :alu_endereco, rows: 3, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "Rua, Número, Bairro..." %>
          </div>
          <% if aluno.errors[:alu_endereco].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:alu_endereco).first %></p>
          <% end %>
        </div>
        
        <div class="md:col-span-2">
          <%= form.label :foto, "Foto do Aluno", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:foto].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 p-3 #{border_class}">
            
            <%# LINHA MODIFICADA ABAIXO %>
            <%= form.file_field :foto, class: "block w-full text-gray-500 dark:text-gray-400
                  file:mr-4 file:cursor-pointer file:transition-all file:transform hover:file:scale-105
                  file:py-2.5 file:px-6
                  file:bg-white dark:file:bg-black
                  file:text-[#C5A300] file:font-bold
                  file:rounded-lg file:shadow-md
                  file:border file:border-[#C5A300]
                  hover:file:bg-gray-100 dark:hover:file:bg-[#1A1A1A]
                  file:focus:outline-none" %>
            <%# FIM DA MODIFICAÇÃO %>
            
          </div>
          <% if aluno.errors[:foto].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:foto).first %></p>
          <% end %>

          <% if aluno.foto.attached? %>
            <div class="mt-3">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Foto Atual:</span>
              <img src="<%= url_for(aluno.foto) %>" alt="<%= aluno.alu_nome %>" class="w-24 h-24 rounded-lg mt-2 object-cover border-2 border-gray-200 dark:border-[#2E2E2E]">
            </div>
          <% end %>
        </div>


        <%# --- DADOS DO RESPONSÁVEL --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Dados do Responsável
        </h3>
        
        <div class="md:col-span-2">
          <%= form.label :responsavel_nome, "Nome do Responsável", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:responsavel_nome].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-user-shield w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.text_field :responsavel_nome, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "Nome do pai, mãe ou responsável" %>
          </div>
          <% if aluno.errors[:responsavel_nome].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:responsavel_nome).first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :responsavel_telefone, "Telefone do Responsável", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:responsavel_telefone].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-phone w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.text_field :responsavel_telefone, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "(XX) 9XXXX-XXXX" %>
          </div>
          <% if aluno.errors[:responsavel_telefone].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:responsavel_telefone).first %></p>
          <% end %>
        </div>
        
        <div>
          <%= form.label :responsavel_email, "Email do Responsável", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:responsavel_email].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-envelope w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.email_field :responsavel_email, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "email@exemplo.com" %>
          </div>
          <% if aluno.errors[:responsavel_email].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:responsavel_email).first %></p>
          <% end %>
        </div>


        <%# --- MATRÍCULA E SAÚDE --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Matrícula e Saúde
        </h3>

        <div>
          <%= form.label :alu_tur_codigo, "Turma", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:alu_tur_codigo].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-chalkboard-teacher w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.collection_select :alu_tur_codigo, @turmas, :tur_codigo, :tur_nome,
                  { include_blank: 'Selecione uma turma' },
                  { class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" } 
            %>
            <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
              <i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i>
            </div>
          </div>
          <% if aluno.errors[:alu_tur_codigo].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:alu_tur_codigo).first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :alu_data_cadastro, "Data da Matrícula", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:alu_data_cadastro].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-calendar-check w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.date_field :alu_data_cadastro, value: (aluno.alu_data_cadastro || Date.today), class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0 [color-scheme:light] dark:[color-scheme:dark]" %>
          </div>
          <% if aluno.errors[:alu_data_cadastro].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:alu_data_cadastro).first %></p>
          <% end %>
        </div>

        <div class="md:col-span-2">
          <%= form.label :alu_status, "Status", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:alu_status].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 flex items-center pointer-events-none">
              <i class="fas fa-toggle-on w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.select :alu_status, 
                  options_for_select(['Ativo', 'Inativo', 'Pendente'], (aluno.alu_status || 'Ativo')), 
                  { }, 
                  { class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" } 
            %>
            <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
              <i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i>
            </div>
          </div>
          <% if aluno.errors[:alu_status].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:alu_status).first %></p>
          <% end %>
        </div>

        <div class="md:col-span-2">
          <%= form.label :condicoes_medicas, "Condições Médicas (Descrição)", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <% border_class = aluno.errors[:condicoes_medicas].any? ? 'border-red-600 ring-1 ring-red-600' : 'border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]' %>
          <div class="flex items-start bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border transition-colors duration-200 #{border_class}">
            <div class="pl-3.5 pt-3.5 flex items-center pointer-events-none">
              <i class="fas fa-briefcase-medical w-5 text-center text-gray-400 dark:text-gray-500"></i>
            </div>
            <%= form.text_area :condicoes_medicas, rows: 3, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "Ex: Asma, alergia a lactose..." %>
          </div>
          <% if aluno.errors[:condicoes_medicas].any? %>
            <p class="text-red-500 dark:text-red-400 text-xs mt-1"><%= aluno.errors.full_messages_for(:condicoes_medicas).first %></p>
          <% end %>
        </div>

      </div>
    </div>

    <%# Botões de ação com modo claro/escuro %>
    <div class="bg-gray-50 dark:bg-[#111111] px-6 py-4 border-t border-gray-200 dark:border-[#2E2E2E] flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3">
      <%# Botão Cancelar (Estilo secundário) %>
      <%= link_to alunos_path, 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-600 dark:text-gray-300 font-bold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' do %>
        <span>Cancelar</span>
      <% end %>
      
      <%# Botão Salvar (Estilo de marca) %>
      <%= form.submit (aluno.persisted? ? 'Atualizar Aluno' : 'Salvar Aluno'), 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-100 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' 
      %>
    </div>

  <% end %>
</div>