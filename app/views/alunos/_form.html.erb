<%# Wrapper principal e cabeçalho (Mantido igual) %>
<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <div class="text-center mb-6">
    <h1 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">
      <%= aluno.persisted? ? "Editar Aluno" : "Novo Aluno" %>
    </h1>
    <p class="mt-3 max-w-xl mx-auto text-lg text-gray-500 dark:text-gray-400">
      Preencha os detalhes abaixo para <%= aluno.persisted? ? "atualizar o" : "cadastrar um novo" %> aluno.
    </p>
  </div>

  <%= form_with(model: aluno, class: "bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-[#2E2E2E]") do |form| %>
    
    <%# Bloco de erros (Mantido igual) %>
    <% if aluno.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900 dark:bg-opacity-50 text-red-700 dark:text-red-300 p-4 border-b border-red-200 dark:border-red-800">
        <h3 class="font-bold mb-2 text-red-800 dark:text-red-200">Oops! <%= pluralize(aluno.errors.count, "erro") %> impediu o salvamento:</h3>
        <ul class="list-disc list-inside text-sm">
          <% aluno.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">

        <%# --- DADOS DO ALUNO --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Dados do Aluno
        </h3>

        <%# Campos usando o Helper Personalizado %>
        <%= tailwind_field form, :alu_nome, "Nome Completo", "fa-user", wrapper_class: "md:col-span-2", placeholder: "Nome completo do aluno" %>
        
        <%= tailwind_field form, :alu_data_nascimento, "Data de Nascimento", "fa-calendar-alt", field_type: :date_field %>

        <%= tailwind_field form, :alu_endereco, "Endereço", "fa-map-marker-alt", field_type: :text_area, wrapper_class: "md:col-span-2", placeholder: "Rua, Número, Bairro...", options: { rows: 3 } %>

        <%# Campo de Foto (Manual pois tem preview específico) %>
        <div class="md:col-span-2">
          <%= form.label :foto, "Foto do Aluno", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
          <div class="bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] p-3">
             <%= form.file_field :foto, class: "block w-full text-gray-500 dark:text-gray-400 file:mr-4 file:py-2.5 file:px-6 file:rounded-lg file:border-0 file:text-sm file:font-bold file:bg-white dark:file:bg-black file:text-[#C5A300] hover:file:bg-gray-100" %>
          </div>
          <% if aluno.foto.attached? %>
            <img src="<%= url_for(aluno.foto) %>" class="w-24 h-24 rounded-lg mt-2 object-cover border-2 border-[#C5A300]">
          <% end %>
        </div>

        <%# --- DADOS DO RESPONSÁVEL --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Dados do Responsável
        </h3>

        <%= tailwind_field form, :responsavel_nome, "Nome do Responsável", "fa-user-shield", wrapper_class: "md:col-span-2", placeholder: "Nome do pai, mãe ou responsável" %>
        
        <%= tailwind_field form, :responsavel_telefone, "Telefone do Responsável", "fa-phone", placeholder: "(XX) 9XXXX-XXXX" %>
        
        <%= tailwind_field form, :responsavel_email, "Email do Responsável", "fa-envelope", field_type: :email_field, placeholder: "email@exemplo.com" %>

        <%# --- MATRÍCULA E SAÚDE --- %>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
          Matrícula e Saúde
        </h3>

        <%# Selects precisam ser manuais ou adaptar o helper, mantive manual para simplicidade %>
        <div>
           <%= form.label :alu_tur_codigo, "Turma", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
           <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E]">
             <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-chalkboard-teacher w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
             <%= form.collection_select :alu_tur_codigo, @turmas, :tur_codigo, :tur_nome, { include_blank: 'Selecione' }, { class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:ring-0" } %>
           </div>
        </div>

        <%= tailwind_field form, :alu_data_cadastro, "Data da Matrícula", "fa-calendar-check", field_type: :date_field %>

        <div>
           <%= form.label :alu_status, "Status", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
           <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E]">
             <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-toggle-on w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
             <%= form.select :alu_status, options_for_select(['Ativo', 'Inativo', 'Pendente'], (aluno.alu_status || 'Ativo')), {}, { class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:ring-0" } %>
           </div>
        </div>

        <%= tailwind_field form, :condicoes_medicas, "Condições Médicas", "fa-briefcase-medical", field_type: :text_area, wrapper_class: "md:col-span-2", placeholder: "Ex: Asma...", options: { rows: 3 } %>

      </div>
    </div>

    <%# Botões de Ação Completos %>
    <div class="bg-gray-50 dark:bg-[#111111] px-6 py-4 border-t border-gray-200 dark:border-[#2E2E2E] flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3">
      
      <%= link_to alunos_path, 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-600 dark:text-gray-300 font-bold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' do %>
        <span>Cancelar</span>
      <% end %>
      
      <%= form.submit (aluno.persisted? ? 'Atualizar Aluno' : 'Salvar Aluno'), 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-100 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' 
      %>
    </div>

  <% end %>

  
</div>