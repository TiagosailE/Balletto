<%# Wrapper principal e cabeçalho do formulário %>
<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <div class="text-center mb-6">
    
    <%# Foto do Aluno %>
    <% if @aluno.foto.attached? %>
      <img src="<%= url_for(@aluno.foto) %>" alt="<%= @aluno.alu_nome %>" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover border-4 border-[#2E2E2E] shadow-lg">
    <% else %>
      <%# Placeholder se não houver foto %>
      <div class="w-32 h-32 rounded-full mx-auto mb-4 bg-[#0A0A0A] border-4 border-[#2E2E2E] flex items-center justify-center shadow-lg">
        <i class="fas fa-user fa-3x text-gray-500"></i>
      </div>
    <% end %>

    <h1 class="text-4xl font-extrabold text-[#C5A300] sm:text-5xl">
      <%= @aluno.alu_nome %>
    </h1>
    <p class="mt-3 max-w-xl mx-auto text-lg text-gray-400">
      Detalhes do Aluno
    </p>
  </div>

  <%# Card principal de conteúdo, estilizado como o formulário %>
  <div class="bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-[#2E2E2E]">
    
    <%# Padding interno e layout em grid %>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
        
        <%# --- DADOS DO ALUNO --- %>
        <h3 class="text-lg font-semibold text-gray-200 md:col-span-2 mt-4 first:mt-0 border-b border-[#2E2E2E] pb-1">
          Dados do Aluno
        </h3>

        <div class="md:col-span-2">
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-toggle-on w-5 text-center text-gray-500 mr-2"></i>Status</span>
          <%# Badge de Status Colorido %>
          <% status_color = case @aluno.alu_status
                            when 'Ativo' then 'bg-green-600 bg-opacity-30 text-green-300'
                            when 'Inativo' then 'bg-red-600 bg-opacity-30 text-red-300'
                            else 'bg-yellow-600 bg-opacity-30 text-yellow-300'
                            end %>
          <p class="text-lg font-semibold px-3 py-1 rounded-full inline-block <%= status_color %>">
            <%= @aluno.alu_status %>
          </p>
        </div>

        <div>
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-calendar-alt w-5 text-center text-gray-500 mr-2"></i>Data de Nascimento</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.alu_data_nascimento %></p>
        </div>
        
        <div>
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-chalkboard-teacher w-5 text-center text-gray-500 mr-2"></i>Turma</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.turma&.tur_nome || 'Sem turma' %></p>
        </div>

        <div class="md:col-span-2">
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-map-marker-alt w-5 text-center text-gray-500 mr-2"></i>Endereço</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.alu_endereco %></p>
        </div>

        <div>
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-calendar-check w-5 text-center text-gray-500 mr-2"></i>Data de Cadastro</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.alu_data_cadastro %></p>
        </div>

        <%# --- DADOS DO RESPONSÁVEL --- %>
        <h3 class="text-lg font-semibold text-gray-200 md:col-span-2 mt-4 border-b border-[#2E2E2E] pb-1">
          Dados do Responsável
        </h3>

        <div class="md:col-span-2">
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-user-shield w-5 text-center text-gray-500 mr-2"></i>Nome</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.responsavel_nome %></p>
        </div>

        <div>
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-phone w-5 text-center text-gray-500 mr-2"></i>Telefone</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.responsavel_telefone %></p>
        </div>
        
        <div>
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-envelope w-5 text-center text-gray-500 mr-2"></i>Email</span>
          <p class="text-lg text-[#E5E5E5]"><%= @aluno.responsavel_email %></p>
        </div>

        <%# --- SAÚDE --- %>
        <h3 class="text-lg font-semibold text-gray-200 md:col-span-2 mt-4 border-b border-[#2E2E2E] pb-1">
          Saúde
        </h3>

        <div class="md:col-span-2">
          <span class="text-sm font-medium text-gray-400 mb-1 flex items-center"><i class="fas fa-briefcase-medical w-5 text-center text-gray-500 mr-2"></i>Condições Médicas</span>
          <%# whitespace-pre-wrap preserva quebras de linha do textarea %>
          <p class="text-lg text-[#E5E5E5] whitespace-pre-wrap"><%= @aluno.condicoes_medicas.presence || 'Nenhuma condição informada.' %></p>
        </div>

      </div>
    </div>

    <%# Botões de ação estilizados como os do formulário %>
    <div class="bg-[#111111] px-6 py-4 border-t border-[#2E2E2E] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      
      <%# Botão Voltar (Alinhado à esquerda) %>
      <%= link_to alunos_path, 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-300 font-bold rounded-lg shadow-md border border-gray-600 hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' do %>
        <i class="fas fa-arrow-left"></i>
        <span>Voltar</span>
      <% end %>

      <%# Botões Editar e Excluir (Alinhados à direita) %>
      <div class="flex flex-col sm:flex-row gap-3">
        <%# Botão Editar (Estilo do botão Salvar) %>
        <%= link_to edit_aluno_path(@aluno), 
              class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' do %>
          <i class="fas fa-pencil-alt"></i>
          <span>Editar</span>
        <% end %>
        
        <%# Botão Excluir (Estilo do botão Cancelar) %>
        <%= button_to aluno_path(@aluno), 
              method: :delete, 
              data: { confirm: 'Tem certeza que deseja excluir este aluno?' }, 
              class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-red-600 text-white font-bold rounded-lg shadow-md border border-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-red-500 transition-all transform hover:scale-105 cursor-pointer' do %>
          <i class="fas fa-trash-alt"></i>
          <span>Excluir</span>
        <% end %>
      </div>
    </div>
    
  </div>
</div>