<div class="w-full max-w-5xl mx-auto px-4 py-8">
  <div class="bg-gradient-to-br from-[#C5A300] to-[#D4AF37] rounded-3xl shadow-2xl p-8 mb-6 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full -mr-32 -mt-32"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-white rounded-full -ml-24 -mb-24"></div>
    </div>
    
    <div class="relative flex flex-col md:flex-row items-center gap-6 min-w-0">
      <% if @aluno.foto.attached? %>
        <img src="<%= url_for(@aluno.foto) %>" alt="<%= @aluno.alu_nome %>" class="w-36 h-36 rounded-2xl object-cover border-4 border-white shadow-2xl flex-shrink-0">
      <% else %>
        <div class="w-36 h-36 rounded-2xl bg-white bg-opacity-20 backdrop-blur-sm border-4 border-white flex items-center justify-center shadow-2xl flex-shrink-0">
          <i class="fas fa-user fa-4x text-white opacity-80"></i>
        </div>
      <% end %>
      
      <div class="flex-1 text-center md:text-left min-w-0 w-full">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-2 drop-shadow-lg break-words">
          <%= @aluno.alu_nome %>
        </h1>
        <div class="flex flex-wrap gap-3 justify-center md:justify-start items-center">
          <% status_config = case @aluno.alu_status
                            when 'Ativo' then { color: 'bg-green-500', icon: 'fa-check-circle', text: 'text-white' }
                            when 'Inativo' then { color: 'bg-red-500', icon: 'fa-times-circle', text: 'text-white' }
                            else { color: 'bg-yellow-500', icon: 'fa-exclamation-circle', text: 'text-white' }
                            end %>
          <span class="<%= status_config[:color] %> <%= status_config[:text] %> px-4 py-2 rounded-full text-sm font-bold shadow-lg flex items-center gap-2 flex-shrink-0">
            <i class="fas <%= status_config[:icon] %>"></i>
            <%= @aluno.alu_status %>
          </span>
          <span class="bg-white bg-opacity-20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold shadow-lg flex items-center gap-2 break-words">
            <i class="fas fa-chalkboard-teacher flex-shrink-0"></i>
            <span class="break-words"><%= @aluno.turma&.tur_nome || 'Sem turma' %></span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

    <div class="lg:col-span-2 bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl border border-gray-200 dark:border-[#2E2E2E] overflow-hidden min-w-0">
      <div class="bg-gradient-to-r from-[#C5A300] to-[#D4AF37] px-6 py-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-3 break-words">
          <i class="fas fa-user-graduate text-2xl flex-shrink-0"></i>
          <span class="break-words">Dados Pessoais</span>
        </h2>
      </div>
      <div class="p-6 space-y-5 min-w-0">
        <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-[#111111] rounded-xl hover:shadow-md transition-shadow min-w-0">
          <div class="w-10 h-10 rounded-lg bg-[#C5A300] bg-opacity-20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-calendar-alt text-[#C5A300]"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1 break-words">Data de Nascimento</p>
            <p class="text-lg font-semibold text-gray-900 dark:text-[#E5E5E5] break-words"><%= @aluno.alu_data_nascimento %></p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-[#111111] rounded-xl hover:shadow-md transition-shadow min-w-0">
          <div class="w-10 h-10 rounded-lg bg-[#C5A300] bg-opacity-20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-map-marker-alt text-[#C5A300]"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1 break-words">Endereço</p>
            <p class="text-base text-gray-900 dark:text-[#E5E5E5] break-words"><%= @aluno.alu_endereco %></p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-[#111111] rounded-xl hover:shadow-md transition-shadow min-w-0">
          <div class="w-10 h-10 rounded-lg bg-[#C5A300] bg-opacity-20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-calendar-check text-[#C5A300]"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1 break-words">Data de Cadastro</p>
            <p class="text-lg font-semibold text-gray-900 dark:text-[#E5E5E5] break-words"><%= @aluno.alu_data_cadastro %></p>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl border border-gray-200 dark:border-[#2E2E2E] overflow-hidden min-w-0">
      <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-3 break-words">
          <i class="fas fa-heartbeat text-2xl flex-shrink-0"></i>
          <span class="break-words">Saúde</span>
        </h2>
      </div>
      <div class="p-6 min-w-0">
        <div class="bg-blue-50 dark:bg-blue-900 dark:bg-opacity-20 rounded-xl p-4 border-l-4 border-blue-500 min-w-0">
          <p class="text-xs font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wide mb-2 break-words">Condições Médicas</p>
          <p class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap leading-relaxed break-words">
            <%= @aluno.condicoes_medicas.presence || 'Nenhuma condição informada.' %>
          </p>
        </div>
      </div>
    </div>

  </div>

  <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl border border-gray-200 dark:border-[#2E2E2E] overflow-hidden mb-6 min-w-0">
    <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4">
      <h2 class="text-xl font-bold text-white flex items-center gap-3 break-words">
        <i class="fas fa-user-shield text-2xl flex-shrink-0"></i>
        <span class="break-words">Dados do Responsável</span>
      </h2>
    </div>
    <div class="p-6 min-w-0">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 min-w-0">
        <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-[#111111] rounded-xl hover:shadow-md transition-shadow min-w-0">
          <div class="w-10 h-10 rounded-lg bg-purple-500 bg-opacity-20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-user text-purple-600 dark:text-purple-400"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1 break-words">Nome</p>
            <p class="text-base font-semibold text-gray-900 dark:text-[#E5E5E5] break-words"><%= @aluno.responsavel_nome %></p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-[#111111] rounded-xl hover:shadow-md transition-shadow min-w-0">
          <div class="w-10 h-10 rounded-lg bg-purple-500 bg-opacity-20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-phone text-purple-600 dark:text-purple-400"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1 break-words">Telefone</p>
            <p class="text-base font-semibold text-gray-900 dark:text-[#E5E5E5] break-words"><%= @aluno.responsavel_telefone %></p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-[#111111] rounded-xl hover:shadow-md transition-shadow min-w-0">
          <div class="w-10 h-10 rounded-lg bg-purple-500 bg-opacity-20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-envelope text-purple-600 dark:text-purple-400"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1 break-words">Email</p>
            <p class="text-base font-semibold text-gray-900 dark:text-[#E5E5E5] break-words"><%= @aluno.responsavel_email %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl border border-gray-200 dark:border-[#2E2E2E] overflow-hidden">
    <div class="bg-gray-50 dark:bg-[#111111] px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

      <%= link_to alunos_path, 
            class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-600 dark:text-gray-300 font-bold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' do %>
        <i class="fas fa-arrow-left"></i>
        <span>Voltar</span>
      <% end %>

      <div class="flex flex-col sm:flex-row gap-3">
        <%= link_to edit_aluno_path(@aluno), 
              class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-100 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' do %>
          <i class="fas fa-pencil-alt"></i>
          <span>Editar</span>
        <% end %>

        <%= button_to aluno_path(@aluno), 
              method: :delete, 
              data: { confirm: 'Tem certeza que deseja excluir este aluno?' }, 
              class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-red-600 text-white font-bold rounded-lg shadow-md border border-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-red-500 transition-all transform hover:scale-105 cursor-pointer' do %>
          <i class="fas fa-trash-alt"></i>
          <span>Excluir</span>
        <% end %>
      </div>
    </div>
  </div>
</div>