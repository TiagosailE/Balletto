<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Balletto Core" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
      html, body {
        height: 100%;
        width: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
      }
    </style>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 antialiased">
    <div id="balletto-app" class="min-h-screen flex flex-col">
      <header class="bg-[#0A1E3F] text-white shadow-md w-full flex-shrink-0">
        <div class="px-6 h-20 flex items-center">
          <span class="text-2xl font-bold tracking-wider">BALLETTO</span>
        </div>
      </header>
      <main class="flex-grow w-full overflow-y-auto p-4 sm:p-6 lg:p-8">
        <%= yield %>
      </main>
      <%= render 'shared/footer' %>
    </div>
  </body>
</html>

