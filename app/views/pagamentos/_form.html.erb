<%= form_with(model: pagamento, class: "bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-[#2E2E2E]") do |form| %>
  
  <%# Bloco de erros %>
  <% if pagamento.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/50 text-red-700 dark:text-red-300 p-4 border-b border-red-200 dark:border-red-800">
      <h3 class="font-bold mb-2 text-red-800 dark:text-red-200"><%= pluralize(pagamento.errors.count, "erro") %> impediu este lançamento de ser salvo:</h3>
      <ul class="list-disc list-inside text-sm">
        <% pagamento.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Campos do formulário %>
  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">
      
      <%# --- DADOS PRINCIPAIS --- %>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 first:mt-0 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
        Lançamento Financeiro
      </h3>

      <div class="md:col-span-2">
        <%= form.label :pag_descricao, "Descrição", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-edit w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.text_field :pag_descricao, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "Ex: Mensalidade, Taxa de Evento, Conta de Luz" %>
        </div>
      </div>

      <div>
        <%= form.label :pag_valor, "Valor (R$)", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-dollar-sign w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.number_field :pag_valor, step: 0.01, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0", placeholder: "150.00" %>
        </div>
      </div>

      <div>
        <%= form.label :pag_data, "Data do Lançamento", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-calendar-alt w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.datetime_field :pag_data, class: "block w-full bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-4 py-3 placeholder-gray-400 dark:placeholder-gray-500 border-none focus:outline-none focus:ring-0 [color-scheme:light] dark:[color-scheme:dark]" %>
        </div>
      </div>
      
      <div>
        <%= form.label :pag_tipo, "Tipo", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-exchange-alt w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          
          <%# MUDANÇA AQUI: Usando nosso novo helper do Plano B %>
          <%= form.select :pag_tipo, Pagamento.tipos_para_select, {}, class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" %>
          
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none"><i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i></div>
        </div>
      </div>
      
      <div>
        <%= form.label :pag_status, "Status", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-check-circle w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          
          <%# MUDANÇA AQUI: Usando nosso novo helper do Plano B %>
          <%= form.select :pag_status, Pagamento.statuses_para_select, {}, class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" %>
          
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none"><i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i></div>
        </div>
      </div>
      
      <div class="md:col-span-2">
        <%= form.label :pag_metodo, "Método de Pagamento", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-credit-card w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.select :pag_metodo, ['Pix', 'Dinheiro', 'Cartão de Débito', 'Cartão de Crédito', 'Boleto', 'Outro'], { prompt: 'Selecione o método' }, class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" %>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none"><i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i></div>
        </div>
      </div>

      <%# --- ASSOCIAÇÕES --- %>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-200 md:col-span-2 mt-4 border-b border-gray-200 dark:border-[#2E2E2E] pb-1">
        Associações (Opcional)
      </h3>

      <div>
        <%= form.label :caixa_id, "Caixa (Conta)", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-cash-register w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.collection_select :caixa_id, @caixas, :cai_codigo, :cai_nome, { prompt: 'Selecione o caixa' }, class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" %>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none"><i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i></div>
        </div>
      </div>
      
      <div>
        <%= form.label :aluno_id, "Associar ao Aluno", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-user-graduate w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.collection_select :aluno_id, @alunos, :alu_codigo, :alu_nome, { prompt: 'Selecione um aluno (se aplicável)' }, class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" %>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none"><i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i></div>
        </div>
      </div>
      
      <div class="md:col-span-2">
        <%= form.label :evento_id, "Associar ao Evento", class: "flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
        <div class="flex items-center relative bg-gray-50 dark:bg-[#0A0A0A] rounded-lg border border-gray-300 dark:border-[#2E2E2E] focus-within:border-[#C5A300] focus-within:ring-2 focus-within:ring-[#C5A300]">
          <div class="pl-3.5 flex items-center pointer-events-none"><i class="fas fa-calendar-star w-5 text-center text-gray-400 dark:text-gray-500"></i></div>
          <%= form.collection_select :evento_id, @eventos, :EVE_CODIGO, :EVE_NOME, { prompt: 'Selecione um evento (se aplicável)' }, class: "block w-full appearance-none bg-transparent text-gray-900 dark:text-[#E5E5E5] rounded-lg pl-2.5 pr-10 py-3 border-none focus:outline-none focus:ring-0" %>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none"><i class="fas fa-chevron-down text-gray-400 dark:text-gray-500 text-xs"></i></div>
        </div>
      </div>

    </div>
  </div>

  <%# Botões de ação %>
  <div class="bg-gray-50 dark:bg-[#111111] px-6 py-4 border-t border-gray-200 dark:border-[#2E2E2E] flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3">
    
    <%= link_to "Cancelar", pagamentos_path, 
          class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-transparent text-gray-600 dark:text-gray-300 font-bold rounded-lg shadow-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-[#2E2E2E] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-gray-500 transition-all transform hover:scale-105 cursor-pointer' 
    %>
    
    <%= form.submit (pagamento.persisted? ? 'Atualizar Lançamento' : 'Salvar Lançamento'), 
          class: 'w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-2.5 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black focus:ring-[#C5A300] transition-all transform hover:scale-105 cursor-pointer' 
    %>
  </div>

<% end %>