<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <%# 1. Cabeçalho e Botão de Novo Lançamento %>
  <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
    <div>
      <h1 class="text-4xl font-extrabold text-[#B88B00] sm:text-5xl">
        Financeiro
      </h1>
      <p class="mt-2 text-lg text-[#6B747A] dark:text-gray-400">
        Extrato de todos os lançamentos e saldos.
      </p>
    </div>
    <%= link_to new_pagamento_path,
          class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-3 bg-white dark:bg-black text-[#C5A300] font-bold rounded-lg shadow-md border border-[#C5A300] hover:bg-gray-50 dark:hover:bg-[#1A1A1A] hover:text-[#D4AF37] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#C5A300] transition-all transform hover:scale-105" do %>
      <i class="fas fa-plus"></i>
      <span>Novo Lançamento</span>
    <% end %>
  </div>

  <%# 2. Cards de Saldo (do controller) %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    
    <%# Saldo Total %>
    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-[#2E2E2E]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">SALDO TOTAL</p>
          <p class="text-3xl font-bold text-blue-600 dark:text-blue-400 mt-2">
            <%= number_to_currency(@saldo_total) %>
          </p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
          <i class="fas fa-wallet text-white text-xl"></i>
        </div>
      </div>
    </div>
    
    <%# Total Entradas %>
    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-[#2E2E2E]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">ENTRADAS</p>
          <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-2">
            <%= number_to_currency(@total_entradas) %>
          </p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center">
          <i class="fas fa-arrow-up text-white text-xl"></i>
        </div>
      </div>
    </div>
    
    <%# Total Saídas %>
    <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-lg p-6 border border-gray-200 dark:border-[#2E2E2E]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">SAÍDAS</p>
          <p class="text-3xl font-bold text-red-600 dark:text-red-400 mt-2">
            <%= number_to_currency(@total_saidas) %>
          </p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-red-600 rounded-xl flex items-center justify-center">
          <i class="fas fa-arrow-down text-white text-xl"></i>
        </div>
      </div>
    </div>
  </div>

  <%# 3. Tabela de Lançamentos (Extrato) %>
  <div class="bg-white dark:bg-[#1C1C1C] rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-[#2E2E2E]">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-[#2E2E2E]">
      <thead class="bg-gray-50 dark:bg-[#111111]">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Descrição</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Valor</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Associado a</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-[#2E2E2E]">
        <% if @pagamentos.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
              <i class="fas fa-file-invoice-dollar text-3xl mb-2"></i>
              <p>Nenhum lançamento financeiro encontrado.</p>
            </td>
          </tr>
        <% end %>
        
        <% @pagamentos.each do |pagamento| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-[#252525] transition-colors">
            
            <%# Descrição e Data %>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900 dark:text-[#E5E5E5]"><%= pagamento.pag_descricao.presence || "Lançamento" %></div>
              <div class="text-sm text-gray-500 dark:text-gray-400"><%= pagamento.pag_data.strftime("%d/%m/%Y %H:%M") %></div>
            </td>
            
            <%# Valor (Verde ou Vermelho) %>
            <td class="px-6 py-4 whitespace-nowrap">
              <% valor_cor = pagamento.entrada? ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400" %>
              <span class="text-sm font-bold <%= valor_cor %>">
                <%= pagamento.entrada? ? '+' : '-' %> <%= number_to_currency(pagamento.pag_valor) %>
              </span>
              <div class="text-sm text-gray-500 dark:text-gray-400"><%= pagamento.caixa.cai_nome %></div>
            </td>
            
            <%# Status %>
            <td class="px-6 py-4 whitespace-nowrap">
              <% status_cor = case pagamento.pag_status
                              when 'pago' then 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300'
                              when 'pendente' then 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300'
                              else 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300'
                              end %>
              <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_cor %>">
                <%= pagamento.pag_status.capitalize %>
              </span>
            </td>

            <%# Associado a (Aluno ou Evento) %>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              <% if pagamento.aluno.present? %>
                <i class="fas fa-user-graduate w-4 text-center mr-1 text-[#C5A300]"></i>
                <%= pagamento.aluno.alu_nome %>
              <% elsif pagamento.evento.present? %>
                <i class="fas fa-calendar-star w-4 text-center mr-1 text-purple-500"></i>
                <%= pagamento.evento.EVE_NOME %>
              <% else %>
                Lançamento Interno
              <% end %>
            </td>
            
            <%# Ações %>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to edit_pagamento_path(pagamento), class: "text-[#C5A300] hover:text-[#D4AF37] mr-3" do %>
                <i class="fas fa-edit"></i> Editar
              <% end %>
              <%= link_to pagamento, 
                    data: { "turbo-method": :delete, "turbo-confirm": "Tem certeza que quer excluir este lançamento?" },
                    class: "text-red-600 hover:text-red-800 dark:text-red-500 dark:hover:text-red-400" do %>
                <i class="fas fa-trash-alt"></i> Excluir
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>